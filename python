    def import_good_folder(self) -> None:
        """Import all supported images from a user-selected folder into the selected product."""
        if self.training_auto or self.training_model_running or self.monitoring:
            messagebox.showwarning("Folder import", "Stop capture/monitoring/training first.")
            return
        name = self.selected_product_name()
        if not name:
            messagebox.showwarning("Folder import", "Create/select a product first.")
            return

        folder = filedialog.askdirectory(title=f"Select GOOD image folder for '{name}'")
        if not folder:
            return
        source = Path(folder)
        files = sorted(
            [p for p in source.rglob("*") if p.is_file() and p.suffix.lower() in VALID_IMAGE_EXTENSIONS],
            key=lambda x: str(x).lower(),
        )
        if not files:
            messagebox.showinfo(
                "Folder import",
                "No supported images were found in the selected folder or its subfolders.\n\n"
                "Supported: JPG, JPEG, PNG, BMP."
            )
            return

        _, product_dir = self.ensure_product(name)
        good_dir = product_dir / "good"
        if not messagebox.askyesno(
            "Import GOOD images",
            f"Import {len(files)} image(s) into '{name}'?\n\n"
            "Only GOOD images of this one product should be in the selected folder.\n"
            "The images will be COPIED; the source folder will not be modified."
        ):
            return

        copied = 0
        skipped = 0
        existing_names = {p.name.lower() for p in good_dir.iterdir() if p.is_file()}
        for source_path in files:
            try:
                image = cv2.imread(str(source_path))
                if image is None or image.size == 0:
                    skipped += 1
                    continue
                stem = sanitize_product_directory(source_path.stem) or "image"
                suffix = source_path.suffix.lower()
                target_name = f"folder_{copied:05d}_{stem}{suffix}"
                target = good_dir / target_name
                n = 1
                while target.name.lower() in existing_names or target.exists():
                    target = good_dir / f"folder_{copied:05d}_{stem}_{n}{suffix}"
                    n += 1
                if cv2.imwrite(str(target), image):
                    copied += 1
                    existing_names.add(target.name.lower())
                else:
                    skipped += 1
            except Exception:
                skipped += 1

        self.refresh_training_info()
        self.training_model_var.set(
            f"Dataset changed — {copied} image(s) imported. Build the selected product model."
        )
        self.status_var.set(
            f"Imported {copied} GOOD image(s) into '{name}'"
            + (f"; skipped {skipped}." if skipped else ".")
        )
        messagebox.showinfo(
            "Folder import complete",
            f"Product: {name}\n\nImported: {copied}\nSkipped: {skipped}\n\n"
            "Now click BUILD SELECTED PRODUCT to build/rebuild its model."
        )

