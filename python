# =============================================================================
# V14.1 CALIBRATION RELIABILITY FIX
# =============================================================================
# The previous V13/V14 presentation-calibration routine incorrectly required
# successful object localization + stable-frame sampling to create a GLOBAL
# presentation calibration. That made the calibration button report FAILED
# whenever the foreground detector missed the current part. A global
# presentation calibration does not need to learn a product-specific bbox:
# the target is simply the center of the configured ROI (the on-screen
# perpendicular crosshair), and the gate later validates the live object.
#
# V14.1 therefore separates these concerns:
#   - CALIBRATION = save the global presentation target/tolerance only.
#   - OBJECT LOCALIZATION = used later by the position gate.
# The calibration button can no longer fail because the object detector failed.

V14_1_CALIBRATION_SAVE_DELAY_SEC = 0.45
V14_1_CALIBRATION_TOL_X = 0.18
V14_1_CALIBRATION_TOL_Y = 0.18


def _v14_1_start_position_calibration(self: InspectionApp) -> None:
    if self.monitoring or self.training_auto or self.training_model_running:
        messagebox.showwarning(
            "Position calibration",
            "Stop monitoring, auto capture, or model training first.",
        )
        return
    with self.frame_lock:
        frame = None if self.current_frame is None else self.current_frame.copy()
    if frame is None or frame.size == 0:
        messagebox.showwarning(
            "Position calibration",
            "Camera frame is not available yet. Wait for the live camera, then press CALIBRATE again.",
        )
        return

    # Global calibration is intentionally product-independent. It defines the
    # target center of the current ROI and the operator's acceptable placement
    # envelope. No object segmentation is required to create it.
    self.position_calibration_active = True
    self.position_calibration_until = time.monotonic() + V14_1_CALIBRATION_SAVE_DELAY_SEC
    self.position_calibration_next_sample = 0.0
    self.position_calibration_samples = []
    self.position_calibration_previous_gray = None
    self.position_ready = False
    self.position_bbox = None
    self.position_message = "CALIBRATING GLOBAL POSITION — KEEP THE PART ON THE CROSSHAIR"
    self.position_detail = "Saving the global presentation target..."
    self.calibration_var.set("Presentation calibration: SAVING...")
    self.position_gate_var.set("POSITION: CALIBRATING")
    self.position_detail_var.set(self.position_detail)
    self.status_var.set(
        "Global presentation calibration is being saved. The crosshair at the ROI center is the permanent target for all products."
    )


def _v14_1_finish_position_calibration(self: InspectionApp) -> None:
    data = {
        "version": V13_POSITION_CALIBRATION_VERSION,
        "calibrated_at": now_text(),
        "roi_signature": list(self.roi),
        "target_center_x": 0.5,
        "target_center_y": 0.5,
        "tolerance_x": V14_1_CALIBRATION_TOL_X,
        "tolerance_y": V14_1_CALIBRATION_TOL_Y,
        "sample_count": 0,
        "calibration_method": "ROI_CENTER_CROSSHAIR_GLOBAL",
        "note": "Global presentation calibration. It does not depend on object detection or product identity.",
    }
    try:
        V13_POSITION_CALIBRATION_PATH.write_text(
            json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8"
        )
    except OSError as exc:
        self.position_calibration_active = False
        self.position_calibration = None
        self.calibration_var.set("Presentation calibration: SAVE ERROR")
        self.position_gate_var.set("POSITION: CALIBRATE FIRST")
        self.position_detail_var.set(f"Could not save calibration file: {exc}")
        self.status_var.set("Global presentation calibration could not be saved.")
        return

    self.position_calibration = data
    self.position_calibration_active = False
    self.position_calibration_until = 0.0
    self.position_calibration_samples = []
    self.position_calibration_previous_gray = None
    self.position_ready = False
    self.position_bbox = None
    self.position_message = "POSITION: READY TO CHECK"
    self.position_detail = (
        f"Global calibration saved. Center tolerance ±{V14_1_CALIBRATION_TOL_X:.2f} X / ±{V14_1_CALIBRATION_TOL_Y:.2f} Y. "
        "This calibration is shared by all products and survives restart."
    )
    self.calibration_var.set(
        f"Presentation calibration: SAVED | {data['calibrated_at']} | GLOBAL / ALL PRODUCTS"
    )
    self.position_gate_var.set(self.position_message)
    self.position_detail_var.set(self.position_detail)
    self.status_var.set(
        "Global presentation calibration saved successfully. No product-specific recalibration is required."
    )


def _v14_1_process_position_calibration(self: InspectionApp, frame: np.ndarray) -> None:
    if not self.position_calibration_active:
        return
    if time.monotonic() >= self.position_calibration_until:
        _v14_1_finish_position_calibration(self)
        return
    # No object detection, no motion threshold, and no contour dependency here.
    # The global target is the ROI center by design.
    self.position_gate_var.set("POSITION: CALIBRATING")
    self.position_detail_var.set("Saving global center target... please wait")


# Override the old calibration methods and camera-loop binding while preserving
# the rest of the V14/V10 pipeline.
InspectionApp.start_position_calibration = _v14_1_start_position_calibration
InspectionApp._process_position_calibration = _v14_1_process_position_calibration


