_v13_original_fit_product = LabeledProductModel.fit_product


def _v13_fit_product(self: LabeledProductModel, *args, **kwargs):
    product = _v13_original_fit_product(self, *args, **kwargs)
    product.identity_nn_threshold = max(float(product.identity_nn_threshold), V13_IDENTITY_MIN_THRESHOLD)
    product.identity_centroid_threshold = max(float(product.identity_centroid_threshold), V13_IDENTITY_MIN_THRESHOLD)
    return product


LabeledProductModel.fit_product = _v13_fit_product

_v13_original_model_load = LabeledProductModel.load


def _v13_model_load(self: LabeledProductModel, folder: Path) -> Path:
    path = _v13_original_model_load(self, folder)
    for product in self.products:
        product.identity_nn_threshold = max(float(product.identity_nn_threshold), V13_IDENTITY_MIN_THRESHOLD)
        product.identity_centroid_threshold = max(float(product.identity_centroid_threshold), V13_IDENTITY_MIN_THRESHOLD)
    return path


LabeledProductModel.load = _v13_model_load

