    def start_monitoring(self) -> None:
        if self.model is None:
            self.load_model_clicked()
        if self.model is None:
            return
        self.monitoring = True
        self.trigger_state = "ARMED"
        self.inference_in_progress = False
        self.background_gray = None
        self.previous_gray = None
        self.event_background_gray = None
        self.last_inspected_gray = None
        self.last_inference_roi = None
        self.remove_counter = 0
        self.replacement_counter = 0
        self.wait_remove_started_at = 0.0
        self.esp.send("I")
        self.result_var.set("RESULT: WAITING")
        self.product_var.set("PRODUCT: --")
        self.monitor_event_var.set("Event: ARMED — waiting for a product")
        self.status_var.set("Continuous monitoring started. Remove any object from the ROI for the first background frame.")

    def stop_monitoring(self) -> None:
        self.monitoring = False
        self.trigger_state = "ARMED"
        self.inference_in_progress = False
        self.remove_counter = 0
        self.replacement_counter = 0
        self.esp.send("I")
        self.monitor_event_var.set("Event: MONITOR OFF")
        self.status_var.set("Continuous monitoring stopped.")

    def rearm_sensor(self) -> None:
        self.trigger_state = "ARMED"
        self.stable_counter = 0
        self.remove_counter = 0
        self.replacement_counter = 0
        self.wait_remove_started_at = 0.0
        self.background_gray = None
        self.previous_gray = None
        self.event_background_gray = None
        self.last_inspected_gray = None
        self.last_inference_roi = None
        self.inference_in_progress = False
        self.monitor_event_var.set("Event: ARMED — waiting for a product")
        self.esp.send("I")
        self.status_var.set("Virtual sensor reset/re-armed. Keep ROI empty for a moment before introducing the next part.")

    def test_once(self) -> None:
        if self.model is None:
            messagebox.showwarning("Inspection", "Load the saved V10 model set first.")
            return
        with self.frame_lock:
            frame = None if self.current_frame is None else self.current_frame.copy()
        if frame is None:
            messagebox.showwarning("Inspection", "Camera frame is not available yet.")
            return
        self._schedule_inference(crop_roi(frame, self.roi), manual=True)

