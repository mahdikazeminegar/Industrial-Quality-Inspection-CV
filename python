def now_text() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def timestamp_for_file() -> str:
    return datetime.now().strftime("%Y%m%d_%H%M%S_%f")[:-3]


def sanitize_product_directory(name: str) -> str:
    """Windows-safe directory name while preserving Persian/Unicode text."""
    cleaned = (name or "").strip()
    cleaned = re.sub(r'[<>:"/\\|?*\x00-\x1F]', "_", cleaned)
    cleaned = cleaned.rstrip(" .")
    return cleaned[:100] if cleaned else "product"


def crop_roi(frame: np.ndarray, roi: tuple[int, int, int, int]) -> np.ndarray:
    h, w = frame.shape[:2]
    x, y, rw, rh = roi
    rw = max(20, min(int(rw), w))
    rh = max(20, min(int(rh), h))
    x = max(0, min(int(x), max(0, w - rw)))
    y = max(0, min(int(y), max(0, h - rh)))
    return frame[y:y + rh, x:x + rw].copy()


def _safe_add_weighted(base: np.ndarray, overlay: np.ndarray, alpha: float = 0.65, beta: float = 0.35) -> np.ndarray:
    """Blend two images safely when webcam/heatmap sizes differ."""
    if base is None:
        return overlay
    if overlay is None:
        return base
    if base.shape[:2] != overlay.shape[:2]:
        overlay = cv2.resize(overlay, (base.shape[1], base.shape[0]), interpolation=cv2.INTER_LINEAR)
    if base.dtype != overlay.dtype:
        overlay = overlay.astype(base.dtype, copy=False)
    return cv2.addWeighted(base, float(alpha), overlay, float(beta), 0.0)


def _safe_absdiff(a: Optional[np.ndarray], b: Optional[np.ndarray]) -> Optional[np.ndarray]:
    """Return absdiff only when the two arrays have compatible shape and dtype."""
    if a is None or b is None:
        return None
    if a.shape != b.shape:
        return None
    if a.dtype != b.dtype:
        try:
            b = b.astype(a.dtype, copy=False)
        except Exception:
            return None
    return cv2.absdiff(a, b)


def _safe_absdiff_mean(a: Optional[np.ndarray], b: Optional[np.ndarray]) -> Optional[float]:
    diff = _safe_absdiff(a, b)
    if diff is None:
        return None
    return float(np.mean(diff))


def _border_pixels(image: np.ndarray, border: int = 8) -> np.ndarray:
    h, w = image.shape[:2]
    b = max(2, min(border, h // 4, w // 4))
    pieces = [
        image[:b, :, :].reshape(-1, 3),
        image[-b:, :, :].reshape(-1, 3),
        image[:, :b, :].reshape(-1, 3),
        image[:, -b:, :].reshape(-1, 3),
    ]
    return np.vstack(pieces)


def estimate_object_bbox(image: np.ndarray) -> tuple[int, int, int, int]:
    """Estimate a foreground bounding box; safely fall back to the full image."""
    if image is None or image.size == 0:
        raise ValueError("Empty image received for object localization.")
    h, w = image.shape[:2]
    if h < 32 or w < 32:
        return 0, 0, w, h

    try:
        border = _border_pixels(image)
        lab = cv2.cvtColor(image, cv2.COLOR_BGR2LAB).astype(np.float32)
        border_lab = cv2.cvtColor(border.reshape(-1, 1, 3), cv2.COLOR_BGR2LAB).reshape(-1, 3)
        bg = np.median(border_lab, axis=0)
        dist = np.linalg.norm(lab - bg.reshape(1, 1, 3), axis=2)
        dist = cv2.GaussianBlur(dist.astype(np.float32), (5, 5), 0)
        d8 = cv2.normalize(dist, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)
        _, mask = cv2.threshold(d8, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel, iterations=2)
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel, iterations=1)

        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        total = float(h * w)
        best_box = None
        best_score = -1.0
        cx0, cy0 = w / 2.0, h / 2.0
        for contour in contours:
            area = float(cv2.contourArea(contour))
            if area < 0.025 * total or area > 0.94 * total:
                continue
            x, y, bw, bh = cv2.boundingRect(contour)
            cx = x + bw / 2.0
            cy = y + bh / 2.0
            center_dist = ((cx - cx0) / max(cx0, 1.0)) ** 2 + ((cy - cy0) / max(cy0, 1.0)) ** 2
            centrality = 1.0 / (1.0 + 1.8 * center_dist)
            rectangularity = min(1.0, area / max(float(bw * bh), 1.0))
            score = area * (0.75 + 0.25 * centrality) * (0.85 + 0.15 * rectangularity)
            if score > best_score:
                best_score = score
                best_box = (x, y, bw, bh)

        if best_box is None:
            return 0, 0, w, h

        x, y, bw, bh = best_box
        pad = max(2, int(round(0.08 * max(bw, bh))))
        x1 = max(0, x - pad)
        y1 = max(0, y - pad)
        x2 = min(w, x + bw + pad)
        y2 = min(h, y + bh + pad)
        return int(x1), int(y1), int(max(16, x2 - x1)), int(max(16, y2 - y1))
    except cv2.error:
        return 0, 0, w, h


def canonicalize_object(image: np.ndarray) -> tuple[np.ndarray, tuple[int, int, int, int]]:
    """Translate/scale-normalize the visible object while retaining a safe fallback."""
    h, w = image.shape[:2]
    x, y, bw, bh = estimate_object_bbox(image)
    crop = image[y:y + bh, x:x + bw].copy()
    if crop.size == 0:
        x, y, bw, bh = 0, 0, w, h
        crop = image.copy()

    border = _border_pixels(image)
    bg_color = np.median(border, axis=0).astype(np.uint8)
    side = max(crop.shape[0], crop.shape[1])
    canvas = np.empty((side, side, 3), dtype=np.uint8)
    canvas[:] = bg_color
    oy = (side - crop.shape[0]) // 2
    ox = (side - crop.shape[1]) // 2
    canvas[oy:oy + crop.shape[0], ox:ox + crop.shape[1]] = crop
    canonical = cv2.resize(canvas, (INPUT_SIZE, INPUT_SIZE), interpolation=cv2.INTER_AREA)
    return canonical, (int(x), int(y), int(bw), int(bh))


def identity_augmentation(image: np.ndarray, seed: int) -> np.ndarray:
    """Small appearance variation used only to calibrate identity tolerance."""
    rng = np.random.default_rng(seed)
    alpha = float(rng.uniform(0.94, 1.06))
    beta = int(rng.integers(-7, 8))
    aug = cv2.convertScaleAbs(image, alpha=alpha, beta=beta)
    if rng.random() < 0.5:
        aug = cv2.GaussianBlur(aug, (3, 3), 0)
    return aug


def identity_augmentations_for_images(images: list[np.ndarray]) -> list[np.ndarray]:
    augmented: list[np.ndarray] = []
    for i, image in enumerate(images):
        canonical, _ = canonicalize_object(image)
        augmented.append(identity_augmentation(canonical, seed=1000 + i))
    return augmented


def read_images(paths: list[Path]) -> list[np.ndarray]:
    images: list[np.ndarray] = []
    for path in paths:
        image = cv2.imread(str(path))
        if image is not None and image.size:
            images.append(image)
    return images


def cosine_distance(vector: np.ndarray, bank: np.ndarray) -> np.ndarray:
    """Cosine distance that accepts either a single vector or a 2-D bank."""
    v = np.asarray(vector, dtype=np.float32).reshape(1, -1)
    b = np.asarray(bank, dtype=np.float32)
    if b.ndim == 1:
        b = b.reshape(1, -1)
    if b.ndim != 2:
        raise ValueError(f"Expected a vector or 2-D bank; got shape {b.shape}.")
    if v.shape[1] != b.shape[1]:
        raise ValueError(
            f"Embedding dimension mismatch: query={v.shape[1]} bank={b.shape[1]}."
        )
    v = v / max(float(np.linalg.norm(v)), 1e-8)
    b = b / np.maximum(np.linalg.norm(b, axis=1, keepdims=True), 1e-8)
    return (1.0 - (v @ b.T)[0]).astype(np.float32)


def robust_upper(values: np.ndarray, margin: float, floor: float = 0.0) -> float:
    values = np.asarray(values, dtype=np.float32).reshape(-1)
    values = values[np.isfinite(values)]
    if values.size == 0:
        return max(floor, 1e-6)
    med = float(np.median(values))
    mad = float(np.median(np.abs(values - med)))
    robust = med + 4.5 * 1.4826 * mad if mad > 1e-9 else float(np.max(values))
    p99 = float(np.percentile(values, 99.0))
    mx = float(np.max(values))
    return max(floor, robust, p99, mx * margin, 1e-6)


def motion_metrics(
    gray: np.ndarray,
    background: Optional[np.ndarray],
    previous: Optional[np.ndarray],
) -> tuple[float, float]:
    if background is None:
        return 0.0, 0.0
    bg_diff = _safe_absdiff(gray, background)
    if bg_diff is None:
        return 0.0, 0.0
    ratio = float(np.mean(bg_diff >= MOTION_PIXEL_THRESHOLD))
    _fd = _safe_absdiff_mean(gray, previous)
    frame_diff = 0.0 if _fd is None else _fd
    return ratio, frame_diff


