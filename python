# =============================================================================
# V13 patch layer
# =============================================================================
# V13 intentionally keeps the V10 model format and recognition core. The new
# presentation gate is global/persistent because product identity is unknown
# until after the vision model runs. This avoids the V12 failure mode where a
# product-specific position/size calibration could reject another product.

APP_TITLE = "Intelligent Vision-Based Industrial Inspection — V15 Industrial Vision QC + Arduino UNO HMI"
V13_POSITION_CALIBRATION_PATH = BASE_DIR / "position_calibration_v13.json"
V13_POSITION_CALIBRATION_VERSION = 1
V13_POSITION_TOL_X = 0.16
V13_POSITION_TOL_Y = 0.16
V13_POSITION_MIN_AREA = 0.008
V13_POSITION_MAX_AREA = 0.97
V13_POSITION_TOO_SMALL_AREA = 0.010
V13_POSITION_TOO_LARGE_AREA = 0.92
V13_POSITION_CALIBRATION_SECONDS = 3.0
V13_POSITION_CALIBRATION_FRAMES = 18
V13_POSITION_CALIBRATION_SAMPLE_INTERVAL = 0.12
V13_POSITION_CALIBRATION_MAX_OFFSET = 0.26
V13_POSITION_STABLE_DIFF = FRAME_DIFF_STABLE
# Based on the successful V10 operating range observed in the user's inspection logs.
# This prevents a very small, over-fitted learned gate from collapsing to ~0.02.
V13_IDENTITY_MIN_THRESHOLD = 0.050


def _v13_canonicalize_from_bbox(
    image: np.ndarray,
    bbox: tuple[int, int, int, int],
) -> tuple[np.ndarray, tuple[int, int, int, int]]:
    """Canonicalize with the exact bbox already validated by the presentation gate."""
    h, w = image.shape[:2]
    x, y, bw, bh = [int(v) for v in bbox]
    x = max(0, min(x, max(0, w - 1)))
    y = max(0, min(y, max(0, h - 1)))
    bw = max(1, min(bw, w - x))
    bh = max(1, min(bh, h - y))
    crop = image[y:y + bh, x:x + bw].copy()
    if crop.size == 0:
        x, y, bw, bh = 0, 0, w, h
        crop = image.copy()
    border = _border_pixels(image)
    bg_color = np.median(border, axis=0).astype(np.uint8)
    side = max(crop.shape[0], crop.shape[1])
    canvas = np.empty((side, side, 3), dtype=np.uint8)
    canvas[:] = bg_color
    oy = (side - crop.shape[0]) // 2
    ox = (side - crop.shape[1]) // 2
    canvas[oy:oy + crop.shape[0], ox:ox + crop.shape[1]] = crop
    canonical = cv2.resize(canvas, (INPUT_SIZE, INPUT_SIZE), interpolation=cv2.INTER_AREA)
    return canonical, (x, y, bw, bh)


# ------------------------------ model patches ------------------------------
_v13_old_patch_predict = PatchCoreDetector.predict


def _v13_patch_predict(
    self: PatchCoreDetector,
    roi_bgr: np.ndarray,
    canonical_image: Optional[np.ndarray] = None,
    validated_bbox: Optional[tuple[int, int, int, int]] = None,
) -> tuple[bool, float, np.ndarray, float]:
    if self.knn is None:
        raise RuntimeError("Patch model is not loaded.")
    if canonical_image is None:
        if validated_bbox is None:
            canonical, bbox = canonicalize_object(roi_bgr)
        else:
            canonical, bbox = _v13_canonicalize_from_bbox(roi_bgr, validated_bbox)
    else:
        canonical = canonical_image
        bbox = validated_bbox if validated_bbox is not None else estimate_object_bbox(roi_bgr)
    per_image, grid = self.extractor.patch_embedding_lists(
        [canonical], batch_size=1, already_canonical=True
    )
    score, distances = self._score_features(per_image[0], self.knn)
    is_anomaly = score > self.threshold
    patch_map = distances.reshape(grid)
    denominator = max(self.calibration_high - self.calibration_low, 1e-6)
    heat = np.clip((patch_map - self.calibration_low) / denominator, 0.0, 1.0)
    heat = cv2.resize(heat, (INPUT_SIZE, INPUT_SIZE), interpolation=cv2.INTER_CUBIC)
    blur = HEATMAP_BLUR if HEATMAP_BLUR % 2 else HEATMAP_BLUR + 1
    heat = cv2.GaussianBlur(heat, (blur, blur), 0)
    full_heat = np.zeros((roi_bgr.shape[0], roi_bgr.shape[1]), dtype=np.float32)
    x, y, bw, bh = bbox
    if bw > 0 and bh > 0:
        restored = cv2.resize(heat, (bw, bh), interpolation=cv2.INTER_CUBIC)
        x2 = min(full_heat.shape[1], x + bw)
        y2 = min(full_heat.shape[0], y + bh)
        if x2 > x and y2 > y:
            full_heat[y:y2, x:x2] = restored[: y2 - y, : x2 - x]
    return bool(is_anomaly), float(score), full_heat.astype(np.float32), float(self.threshold)


PatchCoreDetector.predict = _v13_patch_predict

_v13_old_defect_predict = ProductDefectClassifier.predict


def _v13_defect_predict(
    self: ProductDefectClassifier,
    image: np.ndarray,
    already_canonical: bool = False,
) -> tuple[str, float, float]:
    if self.classifier is None:
        return "NO_DEFECT_MODEL", 0.0, 0.0
    if already_canonical:
        feature = self.extractor.defect_embeddings_for_canonical([image])[0]
    else:
        feature = self.extractor.defect_embeddings([image])[0]
    probs = self.classifier.predict_proba(feature.reshape(1, -1))[0]
    order = np.argsort(probs)[::-1]
    best_i = int(order[0])
    label = str(self.classifier.classes_[best_i])
    prob = float(probs[best_i])
    margin = float(probs[order[0]] - probs[order[1]]) if len(order) >= 2 else 1.0
    if prob < self.probability_threshold or margin < self.margin_threshold:
        return "UNKNOWN_DEFECT", prob, margin
    return label, prob, margin


ProductDefectClassifier.predict = _v13_defect_predict


def _v13_labeled_predict(
    self: LabeledProductModel,
    roi_bgr: np.ndarray,
    validated_bbox: Optional[tuple[int, int, int, int]] = None,
) -> tuple[str, bool, float, float, float, np.ndarray, float, float, str, float, float]:
    if not self.products:
        raise RuntimeError("No labeled product model is loaded.")

    # One canonical image is shared by Identity, PatchCore and supervised defect
    # classification. This is a key V13 fix for crop drift.
    if validated_bbox is None:
        canonical, used_bbox = canonicalize_object(roi_bgr)
    else:
        canonical, used_bbox = _v13_canonicalize_from_bbox(roi_bgr, validated_bbox)

    query = self.extractor.identity_embeddings(
        [canonical], batch_size=1, already_canonical=True
    )[0]
    query /= max(float(np.linalg.norm(query)), 1e-8)

    probabilities: dict[str, float] = {}
    if self.identity_classifier is not None:
        prob_vector = self.identity_classifier.predict_proba(query.reshape(1, -1))[0]
        labels = [str(x) for x in self.identity_classifier.classes_]
        for i, label in enumerate(labels):
            probabilities[label] = float(prob_vector[i])

    # V10 recognition core: product exemplar/centroid distances are primary.
    # Logistic regression is not a mandatory hard gate for a valid exemplar.
    scored = []
    for product in self.products:
        combined, nearest_mean, centroid_distance = self._product_score(
            query, product, None
        )
        scored.append((combined, nearest_mean, centroid_distance, probabilities.get(product.directory_name), product))
    scored.sort(key=lambda item: item[0])
    best_combined, nearest_mean, centroid_distance, best_prob, best = scored[0]

    exemplar_ok = (
        nearest_mean <= best.identity_nn_threshold
        and centroid_distance <= best.identity_centroid_threshold
    )

    classifier_rescue = False
    if self.identity_classifier is not None and best_prob is not None:
        order_prob = sorted(probabilities.items(), key=lambda kv: kv[1], reverse=True)
        pred = order_prob[0][0] if order_prob else None
        margin = (order_prob[0][1] - order_prob[1][1]) if len(order_prob) >= 2 else 1.0
        classifier_rescue = (
            pred == best.directory_name
            and best_prob >= max(0.70, float(self.classifier_prob_threshold))
            and margin >= max(0.12, float(self.classifier_margin_threshold))
        )

    identity_ok = exemplar_ok or classifier_rescue

    # Only invoke ambiguity rejection when the best product is already outside
    # its own learned exemplar/centroid envelope.
    if not exemplar_ok and len(scored) > 1:
        second = scored[1][0]
        relative_gap = (second - best_combined) / max(abs(second), 1e-6)
        if relative_gap < UNKNOWN_MARGIN_RATIO and not classifier_rescue:
            identity_ok = False

    if not identity_ok:
        return (
            "UNKNOWN PRODUCT", True, 0.0, float(nearest_mean),
            float(best.identity_nn_threshold),
            np.zeros((roi_bgr.shape[0], roi_bgr.shape[1]), dtype=np.float32),
            0.0, float(best_combined), "UNKNOWN_DEFECT", 0.0, 0.0,
        )

    anomaly, anomaly_score, heatmap, anomaly_threshold = best.detector.predict(
        roi_bgr, canonical_image=canonical, validated_bbox=used_bbox
    )
    defect_label = "NO_DEFECT_MODEL"
    defect_probability = 0.0
    defect_margin = 0.0
    if best.defect_classifier is not None:
        defect_label, defect_probability, defect_margin = best.defect_classifier.predict(
            canonical, already_canonical=True
        )
    else:
        defect_label = "GOOD" if not anomaly else "UNKNOWN_ANOMALY"
    return (
        best.name, bool(anomaly), float(anomaly_score), float(nearest_mean),
        float(best.identity_nn_threshold), heatmap, float(anomaly_threshold),
        float(best_combined), defect_label, float(defect_probability), float(defect_margin),
    )


LabeledProductModel.predict = _v13_labeled_predict



