    # -------------------------------------------------------------------------
    # Model training / loading
    # -------------------------------------------------------------------------
    def _ensure_extractor(self) -> ResNet18FeatureExtractor:
        if self.extractor is None:
            self.status_var.set("Loading ResNet-18 pretrained feature extractor. First run may download weights...")
            self.extractor = ResNet18FeatureExtractor()
        return self.extractor

    def _collect_defect_datasets(self, product_name: str) -> dict[str, list[np.ndarray]]:
        result: dict[str, list[np.ndarray]] = {}
        good_files = self.product_files(product_name)
        good_images = read_images(good_files)
        if good_images:
            result["GOOD"] = good_images
        for defect in self.list_defect_types(product_name):
            files = self.defect_files(product_name, defect)
            images = read_images(files)
            if images:
                result[defect] = images
        return result

    def _collect_labeled_datasets(self) -> list[tuple[str, str, list[np.ndarray], dict[str, list[np.ndarray]]]]:
        datasets: list[tuple[str, str, list[np.ndarray], dict[str, list[np.ndarray]]]] = []
        for name in self.list_product_names():
            files = self.product_files(name)
            if len(files) < TRAIN_MINIMUM:
                raise ValueError(
                    f"Product '{name}' has only {len(files)} GOOD images. "
                    f"At least {TRAIN_MINIMUM} are required before BUILD ALL."
                )
            images = read_images(files)
            if len(images) < TRAIN_MINIMUM:
                raise ValueError(f"Some image files for '{name}' could not be read.")
            defect_datasets = self._collect_defect_datasets(name)
            directory_name = sanitize_product_directory(name)
            datasets.append((name, directory_name, images, defect_datasets))
        return datasets

    def _load_existing_model_set_for_update(self) -> LabeledProductModel:
        """Load the current V10 set for an incremental product update.

        Legacy previous-version models are intentionally NOT copied into a V9 update because
        V9 uses stabilized object-normalized identity embeddings and a global classifier. When no V8
        set exists, the selected build will fall back to rebuilding all current
        labeled datasets, which safely migrates the project forward.
        """
        extractor = self._ensure_extractor()
        model = LabeledProductModel(extractor)
        if self.loaded_model_root == MODEL_ROOT and self.model is not None and self.model.products:
            model.products = list(self.model.products)
            model.created_at = self.model.created_at
            model.identity_classifier = self.model.identity_classifier
            model.classifier_prob_threshold = self.model.classifier_prob_threshold
            model.classifier_margin_threshold = self.model.classifier_margin_threshold
            return model
        if (MODEL_ROOT / "registry.json").exists():
            try:
                model.load(MODEL_ROOT)
                return model
            except Exception:
                pass
        return model

    def train_selected_product(self) -> None:
        if self.monitoring or self.training_auto:
            messagebox.showwarning("Training", "Stop Monitoring/Auto Capture first.")
            return
        if self.training_model_running:
            return
        name = self.selected_product_name()
        files = self.product_files(name) if name else []
        if not name:
            messagebox.showwarning("Training", "Select/create a product first.")
            return
        if len(files) < TRAIN_MINIMUM:
            messagebox.showwarning(
                "Training",
                f"'{name}' has {len(files)} GOOD image(s). At least {TRAIN_MINIMUM} are required."
            )
            return
        try:
            self._ensure_extractor()
        except Exception as exc:
            messagebox.showerror("Model", str(exc))
            return
        self.training_model_running = True
        self.progress_bar.configure(mode="indeterminate")
        self.progress_bar.start()
        self.training_state_var.set(f"Training: UPDATING '{name}' WITHOUT DELETING OTHER PRODUCTS")
        threading.Thread(
            target=self._train_selected_worker,
            args=(name, files),
            daemon=True,
        ).start()

    def train_all_products(self) -> None:
        if self.monitoring or self.training_auto:
            messagebox.showwarning("Training", "Stop Monitoring/Auto Capture first.")
            return
        if self.training_model_running:
            return
        try:
            datasets = self._collect_labeled_datasets()
        except Exception as exc:
            messagebox.showerror("Training", str(exc))
            return
        if not datasets:
            messagebox.showwarning("Training", "No labeled products exist yet.")
            return
        try:
            self._ensure_extractor()
        except Exception as exc:
            messagebox.showerror("Model", str(exc))
            return
        self.training_model_running = True
        self.progress_bar.configure(mode="indeterminate")
        self.progress_bar.start()
        self.training_state_var.set("Training: BUILDING / UPDATING ALL PRODUCTS")
        threading.Thread(target=self._train_all_worker, args=(datasets,), daemon=True).start()

    def _train_selected_worker(self, name: str, files: list[Path]) -> None:
        try:
            extractor = self.extractor
            if extractor is None:
                raise RuntimeError("Feature extractor was not initialized.")

            model = self._load_existing_model_set_for_update()
            # First V9 build: rebuild all labeled datasets if no compatible V10 set
            # is available. This prevents selected-product training from erasing
            # other products while also ensuring the new representation is used everywhere.
            if not model.products:
                all_datasets = self._collect_labeled_datasets()
                if all_datasets and len(all_datasets) > 1:
                    self.after(0, lambda: self._update_training_status(
                        "No compatible V10 set exists. Rebuilding all labeled datasets for V10 so no product is lost..."
                    ))
                    model.fit_all(
                        all_datasets,
                        progress=lambda message: self.after(
                            0, lambda msg=message: self._update_training_status(msg)
                        ),
                    )
                    model.created_at = now_text()
                    save_path = model.save(MODEL_ROOT)
                    self.after(0, lambda: self._on_training_finished(model, save_path))
                    return

            images = read_images(files)
            defect_datasets = self._collect_defect_datasets(name)
            product = model.fit_product(
                name,
                sanitize_product_directory(name),
                images,
                defect_datasets=defect_datasets,
                progress=lambda message: self.after(
                    0, lambda msg=message: self._update_training_status(msg)
                ),
            )
            model.upsert_product(product)
            model.rebuild_identity_classifier(
                progress=lambda message: self.after(
                    0, lambda msg=message: self._update_training_status(msg)
                )
            )
            model.created_at = now_text()
            save_path = model.save(MODEL_ROOT)
            self.after(0, lambda: self._on_training_finished(model, save_path))
        except Exception as exc:
            self.after(0, lambda error=exc: self._on_training_failed(error))

    def _train_all_worker(self, datasets: list[tuple[str, str, list[np.ndarray], dict[str, list[np.ndarray]]]]) -> None:
        try:
            extractor = self.extractor
            if extractor is None:
                raise RuntimeError("Feature extractor was not initialized.")
            model = LabeledProductModel(extractor)
            model.fit_all(
                datasets,
                progress=lambda message: self.after(
                    0, lambda msg=message: self._update_training_status(msg)
                ),
            )
            save_path = model.save(MODEL_ROOT)
            self.after(0, lambda: self._on_training_finished(model, save_path))
        except Exception as exc:
            self.after(0, lambda error=exc: self._on_training_failed(error))

    def _update_training_status(self, message: str) -> None:
        self.training_state_var.set("Training: WORKING")
        self.training_info_var.set(message)

    def _on_training_finished(self, model: LabeledProductModel, path: Path) -> None:
        self.training_model_running = False
        self.progress_bar.stop()
        self.progress_bar.configure(mode="determinate")
        self.progress_bar.set(1.0)
        self.model = model
        self.loaded_model_root = MODEL_ROOT
        summary = model.summary()
        self.model_var.set(summary)
        self.training_model_var.set(summary)
        self.training_state_var.set("Training: V10 MODEL SET READY")
        self.status_var.set(f"V10 model set saved: {path}")
        self.refresh_product_combo()
        messagebox.showinfo(
            "Training complete",
            "Model set updated successfully.\n\n"
            f"Learned products now stored: {len(model.products)}\n\n"
            "Building a selected product does NOT delete other learned products. "
            "Monitoring identifies the product automatically."
        )

    def _on_training_failed(self, exc: Exception) -> None:
        self.training_model_running = False
        self.progress_bar.stop()
        self.progress_bar.configure(mode="determinate")
        self.training_state_var.set("Training: ERROR")
        self.training_info_var.set(f"Training failed:\n{exc}")
        self.status_var.set("Model training failed.")
        messagebox.showerror("Training error", str(exc))

    def load_model_clicked(self) -> None:
        try:
            extractor = self._ensure_extractor()
            model = LabeledProductModel(extractor)

            # V9 identity embeddings are intentionally different from V8. A previous-version
            # V7 package can therefore be inspected only through migration/rebuild,
            # not silently mixed with V9 embeddings.
            if (MODEL_ROOT / "registry.json").exists():
                model.load(MODEL_ROOT)
                loaded_from = MODEL_ROOT
            elif (LEGACY_MODEL_ROOT / "registry.json").exists():
                raise RuntimeError(
                    "A previous-version model was found, but V9 uses a new object-normalized identity/anomaly representation.\n\n"
                    "Use TRAINING → BUILD / UPDATE ALL PRODUCTS once to rebuild all labeled GOOD datasets for V10."
                )
            else:
                raise FileNotFoundError(
                    f"No saved V10 model set found. Build the labeled products first.\n\n"
                    f"Expected:\n{MODEL_ROOT / 'registry.json'}"
                )

            self.model = model
            self.loaded_model_root = loaded_from
            summary = model.summary()
            self.model_var.set(summary)
            self.training_model_var.set(summary)
            self.status_var.set(f"Model set loaded from: {loaded_from}")
            messagebox.showinfo("Model set loaded", summary)
        except Exception as exc:
            messagebox.showerror("Load model", str(exc))

    # -------------------------------------------------------------------------
    # Inference
    # -------------------------------------------------------------------------
    def _schedule_inference(self, roi: np.ndarray, manual: bool) -> None:
        if self.model is None:
            self.monitor_event_var.set("Event: no V10 model set loaded")
            return
        if self.inference_in_progress:
            return
        self.inference_in_progress = True
        if not manual:
            self.last_inference_roi = roi.copy()
        if not manual:
            self.trigger_state = "INFERENCE"
            self.monitor_event_var.set("Event: AI identification + anomaly inspection running...")
        else:
            self.monitor_event_var.set("Event: manual AI identification + anomaly inspection running...")
        model = self.model
        threading.Thread(
            target=self._inference_worker,
            args=(model, roi.copy(), manual),
            daemon=True,
        ).start()

    def _inference_worker(self, model: LabeledProductModel, roi: np.ndarray, manual: bool) -> None:
        try:
            (
                product_name,
                is_anomaly,
                anomaly_score,
                identity_distance,
                identity_threshold,
                heatmap,
                anomaly_threshold,
                identity_combined,
                defect_label,
                defect_probability,
                defect_margin,
            ) = model.predict(roi)

            if product_name == "UNKNOWN PRODUCT":
                status = "FAIL"
                defect_type = "UNKNOWN_OR_AMBIGUOUS_PRODUCT"
                display_score = 0.0
            elif defect_label not in ("GOOD", "NO_DEFECT_MODEL", "UNKNOWN_DEFECT", "UNKNOWN_ANOMALY") and defect_probability >= DEFECT_MIN_PROB:
                status = "FAIL"
                defect_type = defect_label
                display_score = anomaly_score
            elif is_anomaly:
                status = "FAIL"
                defect_type = "UNKNOWN_ANOMALY"
                display_score = anomaly_score
            else:
                status = "PASS"
                defect_type = "NONE"
                display_score = anomaly_score

            overlay = self._make_result_overlay(
                roi,
                heatmap,
                status,
                product_name,
                defect_type,
                defect_probability,
                display_score,
                anomaly_threshold,
                identity_distance,
                identity_threshold,
                identity_combined,
            )
            folder = LOG_DIR / sanitize_product_directory(product_name) / datetime.now().strftime("%Y-%m-%d")
            folder.mkdir(parents=True, exist_ok=True)
            image_path = folder / f"{timestamp_for_file()}_{status}.jpg"
            cv2.imwrite(str(image_path), overlay)

            self.db.add(
                product_name,
                status,
                defect_type,
                display_score,
                anomaly_threshold,
                identity_distance,
                identity_threshold,
                defect_probability,
                defect_margin,
                str(image_path),
            )

            self.after(0, lambda: self._on_inference_result(
                status,
                product_name,
                defect_type,
                defect_probability,
                defect_margin,
                display_score,
                anomaly_threshold,
                identity_distance,
                identity_threshold,
                identity_combined,
                overlay,
                str(image_path),
                manual,
            ))
        except Exception as exc:
            self.after(0, lambda error=exc: self._on_inference_error(error))

    def _on_inference_result(
        self,
        status: str,
        product_name: str,
        defect_type: str,
        defect_probability: float,
        defect_margin: float,
        score: float,
        anomaly_threshold: float,
        identity_distance: float,
        identity_threshold: float,
        identity_combined: float,
        overlay: np.ndarray,
        image_path: str,
        manual: bool,
    ) -> None:
        self.inference_in_progress = False
        self.last_result_overlay = overlay
        self.last_result_at = time.monotonic()
        self.inspection_count += 1
        self.result_var.set(f"RESULT: {status}")
        self.product_var.set(f"PRODUCT: {product_name}")

        if product_name == "UNKNOWN PRODUCT":
            self.defect_var.set("DEFECT: UNKNOWN / AMBIGUOUS PRODUCT")
            self.score_var.set("Anomaly score: not evaluated — product identity rejected")
            self.identity_var.set(
                f"Identity distance: {identity_distance:.4f} | threshold: {identity_threshold:.4f}\n"
                f"Identity normalized score: {identity_combined:.3f} → UNKNOWN"
            )
            self.monitor_event_var.set("Event: UNKNOWN / AMBIGUOUS PRODUCT → FAIL")
        else:
            if defect_type == "NONE":
                self.defect_var.set("DEFECT: GOOD")
            elif defect_type == "UNKNOWN_ANOMALY":
                self.defect_var.set("DEFECT: UNKNOWN ANOMALY")
            else:
                self.defect_var.set(
                    f"DEFECT: {defect_type} | confidence={defect_probability:.1%}"
                    if defect_probability > 0 else f"DEFECT: {defect_type}"
                )
            self.score_var.set(
                f"Anomaly score: {score:.5f} | threshold: {anomaly_threshold:.5f}\n"
                f"Defect confidence: {defect_probability:.1%} | margin: {defect_margin:.3f}"
            )
            self.identity_var.set(
                f"Identity distance: {identity_distance:.4f} | gate: {identity_threshold:.4f}\n"
                f"Identity normalized score: {identity_combined:.3f}"
            )
            if status == "FAIL" and defect_type not in {"UNKNOWN_ANOMALY", "UNKNOWN / AMBIGUOUS PRODUCT"}:
                self.monitor_event_var.set(
                    f"Event: DEFECT DETECTED → FAIL / {defect_type} — logged for review"
                )
            else:
                self.monitor_event_var.set(
                    "Event: manual test complete"
                    if manual
                    else "Event: inspection complete — remove the product"
                )

        cycle_ms = (time.monotonic() - self.inspection_started_at) * 1000.0 if self.inspection_started_at > 0 else 0.0
        self.last_cycle_ms = max(0.0, cycle_ms)
        try:
            self.db.update_latest_cycle_time(self.last_cycle_ms)
        except Exception:
            pass
        if hasattr(self, "monitor_cycle_var"):
            self.monitor_cycle_var.set(f"Cycle time: {self.last_cycle_ms:.0f} ms")
        if self.result_label:
            self.result_label.configure(text_color="#2ecc71" if status == "PASS" else "#e74c3c")
        arduino_ok = self.esp.send_result(status, product_name, defect_type, self.last_cycle_ms)
        self.arduino_transfer_var.set(
            "Arduino HMI: result sent" if arduino_ok else "Arduino HMI: not connected / result kept on PC"
        )

        if not manual and self.monitoring:
            self.trigger_state = "WAIT_REMOVE"
            self.wait_remove_started_at = time.monotonic()
            self.remove_counter = 0
            self.replacement_counter = 0
            if self.last_inference_roi is not None:
                self.last_inspected_gray = cv2.GaussianBlur(
                    cv2.cvtColor(self.last_inference_roi, cv2.COLOR_BGR2GRAY), (5, 5), 0
                )
            self.monitor_event_var.set("Event: result complete — waiting for product removal / next part")
        self.status_var.set(f"{status}: {product_name} | {defect_type} | inspection #{self.inspection_count} | saved {image_path}")

    def _on_inference_error(self, exc: Exception) -> None:
        self.inference_in_progress = False
        self.result_var.set("RESULT: ERROR")
        self.monitor_event_var.set(f"Inference error: {type(exc).__name__}: {exc}")
        if self.monitoring:
            self.trigger_state = "ARMED"
            self.background_gray = None
            self.previous_gray = None
            self.event_background_gray = None
        self.status_var.set("Inference failed. The virtual sensor was re-armed; see the Monitoring panel for the exact error.")
        try:
            print("\n[INFERENCE ERROR]")
            import traceback
            traceback.print_exc()
        except Exception:
            pass

    @staticmethod
    def _make_result_overlay(
        roi: np.ndarray,
        heatmap: np.ndarray,
        status: str,
        product_name: str,
        defect_type: str,
        defect_probability: float,
        score: float,
        anomaly_threshold: float,
        identity_distance: float,
        identity_threshold: float,
        identity_combined: float,
    ) -> np.ndarray:
        out = roi.copy()
        if heatmap is not None and float(np.max(heatmap)) > 0:
            heat = np.uint8(np.clip(heatmap, 0, 1) * 255)
            color = cv2.applyColorMap(heat, cv2.COLORMAP_JET)
            out = _safe_add_weighted(out, color, 0.65, 0.35)
        ok_color = (0, 255, 0)
        bad_color = (0, 0, 255)
        border_color = ok_color if status == "PASS" else bad_color
        cv2.rectangle(out, (0, 0), (out.shape[1] - 1, out.shape[0] - 1), border_color, 4)
        cv2.putText(out, f"{status} | {product_name}", (10, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.60, border_color, 2, cv2.LINE_AA)
        cv2.putText(out, f"DEFECT={defect_type}", (10, 54), cv2.FONT_HERSHEY_SIMPLEX, 0.48, (255, 255, 255), 1, cv2.LINE_AA)
        cv2.putText(out, f"DEF CONF={defect_probability:.3f}", (10, 75), cv2.FONT_HERSHEY_SIMPLEX, 0.48, (255, 255, 255), 1, cv2.LINE_AA)
        cv2.putText(out, f"ID dist={identity_distance:.4f} gate={identity_threshold:.4f}", (10, 96), cv2.FONT_HERSHEY_SIMPLEX, 0.46, (255, 255, 255), 1, cv2.LINE_AA)
        cv2.putText(out, f"ID score={identity_combined:.3f}", (10, 116), cv2.FONT_HERSHEY_SIMPLEX, 0.46, (255, 255, 255), 1, cv2.LINE_AA)
        if product_name != "UNKNOWN PRODUCT":
            cv2.putText(out, f"ANOM={score:.4f} THR={anomaly_threshold:.4f}", (10, 136), cv2.FONT_HERSHEY_SIMPLEX, 0.46, (255, 255, 255), 1, cv2.LINE_AA)
        return out

