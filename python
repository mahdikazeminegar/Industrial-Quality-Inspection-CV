def _v13_find_scrollable(parent) -> Optional[object]:
    for child in getattr(parent, "winfo_children", lambda: [])():
        if isinstance(child, ctk.CTkScrollableFrame):
            return child
        found = _v13_find_scrollable(child)
        if found is not None:
            return found
    return None


def _v13_load_position_calibration(self: InspectionApp) -> None:
    self.position_calibration = None
    if not V13_POSITION_CALIBRATION_PATH.exists():
        self.calibration_var.set("Presentation calibration: NOT SET")
        self.position_gate_var.set("POSITION: CALIBRATE FIRST")
        self.position_detail_var.set(
            "One global camera calibration is required. It will then be reused for all products."
        )
        return
    try:
        data = json.loads(V13_POSITION_CALIBRATION_PATH.read_text(encoding="utf-8"))
        if int(data.get("version", -1)) != V13_POSITION_CALIBRATION_VERSION:
            raise ValueError("unsupported calibration version")
        self.position_calibration = data
        self.calibration_var.set(
            f"Presentation calibration: SAVED | {data.get('calibrated_at', 'unknown')} | GLOBAL / ALL PRODUCTS"
        )
        self.position_gate_var.set("POSITION: READY TO CHECK")
        self.position_detail_var.set(
            "Saved calibration is reused automatically. Product size/distance is NOT calibrated separately."
        )
    except Exception as exc:
        self.position_calibration = None
        self.calibration_var.set("Presentation calibration: INVALID")
        self.position_gate_var.set("POSITION: CALIBRATE FIRST")
        self.position_detail_var.set(f"Calibration file error: {exc}")


def _v13_start_position_calibration(self: InspectionApp) -> None:
    if self.monitoring or self.training_auto or self.training_model_running:
        messagebox.showwarning(
            "Position calibration",
            "Stop monitoring, auto capture, or model training first.",
        )
        return
    with self.frame_lock:
        frame = None if self.current_frame is None else self.current_frame.copy()
    if frame is None:
        messagebox.showwarning("Position calibration", "Camera frame is not available yet.")
        return
    self.position_calibration_active = True
    self.position_calibration_until = time.monotonic() + V13_POSITION_CALIBRATION_SECONDS
    self.position_calibration_next_sample = 0.0
    self.position_calibration_samples = []
    self.position_calibration_previous_gray = None
    self.position_ready = False
    self.position_message = "CALIBRATING — CENTER GOOD PART ON CROSSHAIR + HOLD STILL"
    self.position_detail = f"Collecting 0/{V13_POSITION_CALIBRATION_FRAMES} stable frames..."
    self.calibration_var.set("Presentation calibration: RUNNING")
    self.position_gate_var.set("POSITION: CALIBRATING")
    self.position_detail_var.set(self.position_detail)
    self.status_var.set(
        "Global calibration started. Center any GOOD part on the crosshair and keep it still."
    )


def _v13_reset_position_calibration(self: InspectionApp) -> None:
    if self.monitoring or self.training_auto or self.training_model_running:
        messagebox.showwarning(
            "Position calibration",
            "Stop monitoring, auto capture, or model training first.",
        )
        return
    try:
        if V13_POSITION_CALIBRATION_PATH.exists():
            V13_POSITION_CALIBRATION_PATH.unlink()
    except OSError as exc:
        messagebox.showerror("Position calibration", str(exc))
        return
    self.position_calibration = None
    self.position_calibration_active = False
    self.position_calibration_until = 0.0
    self.position_calibration_next_sample = 0.0
    self.position_calibration_samples = []
    self.position_calibration_previous_gray = None
    self.position_previous_gray = None
    self.position_bbox = None
    self.position_ready = False
    self.position_message = "POSITION: CALIBRATE FIRST"
    self.position_detail = "Calibration reset successfully. You can calibrate again immediately."
    self.calibration_var.set("Presentation calibration: NOT SET — READY TO RECALIBRATE")
    self.position_gate_var.set("POSITION: CALIBRATE FIRST")
    self.position_detail_var.set(self.position_detail)
    self.status_var.set("Global presentation calibration reset. Ready to calibrate again.")


def _v13_position_measurement(
    self: InspectionApp, frame: np.ndarray
) -> Optional[tuple[float, float, float, tuple[int, int, int, int]]]:
    roi = crop_roi(frame, self.roi)
    rh, rw = roi.shape[:2]
    if rh < 32 or rw < 32:
        return None
    x, y, bw, bh = estimate_object_bbox(roi)
    area_ratio = float((bw * bh) / max(1, rw * rh))
    if area_ratio < V13_POSITION_MIN_AREA or area_ratio > V13_POSITION_MAX_AREA:
        return None
    cx = (x + 0.5 * bw) / max(1.0, rw)
    cy = (y + 0.5 * bh) / max(1.0, rh)
    return cx, cy, area_ratio, (int(x), int(y), int(bw), int(bh))


def _v13_finish_position_calibration(self: InspectionApp) -> None:
    if not self.position_calibration_samples:
        self.position_calibration_active = False
        self.calibration_var.set("Presentation calibration: FAILED")
        self.position_gate_var.set("POSITION: CALIBRATION FAILED")
        self.position_detail_var.set(
            "No stable object samples were captured. Put a GOOD part on the crosshair and try again."
        )
        return
    arr = np.asarray(self.position_calibration_samples, dtype=np.float32)
    spread_x = float(np.percentile(np.abs(arr[:, 0] - 0.5), 90.0))
    spread_y = float(np.percentile(np.abs(arr[:, 1] - 0.5), 90.0))
    data = {
        "version": V13_POSITION_CALIBRATION_VERSION,
        "calibrated_at": now_text(),
        "roi_signature": list(self.roi),
        "target_center_x": 0.5,
        "target_center_y": 0.5,
        "tolerance_x": V13_POSITION_TOL_X,
        "tolerance_y": V13_POSITION_TOL_Y,
        "observed_center_spread_x": spread_x,
        "observed_center_spread_y": spread_y,
        "sample_count": int(len(arr)),
        "note": "Global presentation calibration; intentionally product-independent.",
    }
    V13_POSITION_CALIBRATION_PATH.write_text(
        json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8"
    )
    self.position_calibration = data
    self.position_calibration_active = False
    self.position_calibration_samples = []
    self.position_calibration_previous_gray = None
    self.calibration_var.set(
        f"Presentation calibration: SAVED | {data['calibrated_at']} | GLOBAL / ALL PRODUCTS"
    )
    self.position_gate_var.set("POSITION: READY TO CHECK")
    self.position_detail_var.set(
        f"Saved {data['sample_count']} stable frames. Center tolerance ±{V13_POSITION_TOL_X:.2f} X / ±{V13_POSITION_TOL_Y:.2f} Y."
    )
    self.status_var.set("Global camera presentation calibration saved. It will be reused for all products.")


def _v13_process_position_calibration(self: InspectionApp, frame: np.ndarray) -> None:
    if not self.position_calibration_active:
        return
    now = time.monotonic()
    if now >= self.position_calibration_until:
        _v13_finish_position_calibration(self)
        return
    roi = crop_roi(frame, self.roi)
    gray = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
    _pf = _safe_absdiff_mean(gray, self.position_calibration_previous_gray)
    frame_diff = 0.0 if _pf is None else _pf
    self.position_calibration_previous_gray = gray
    if now < self.position_calibration_next_sample or frame_diff > V13_POSITION_STABLE_DIFF:
        self.position_detail = (
            f"Collecting {len(self.position_calibration_samples)}/{V13_POSITION_CALIBRATION_FRAMES} — HOLD STILL"
        )
        self.position_detail_var.set(self.position_detail)
        return
    measurement = _v13_position_measurement(self, frame)
    if measurement is None:
        self.position_detail = (
            f"Collecting {len(self.position_calibration_samples)}/{V13_POSITION_CALIBRATION_FRAMES} — object not localized reliably"
        )
        self.position_detail_var.set(self.position_detail)
        return
    cx, cy, area_ratio, _ = measurement
    if abs(cx - 0.5) > V13_POSITION_CALIBRATION_MAX_OFFSET or abs(cy - 0.5) > V13_POSITION_CALIBRATION_MAX_OFFSET:
        self.position_detail = (
            f"Collecting {len(self.position_calibration_samples)}/{V13_POSITION_CALIBRATION_FRAMES} — MOVE object onto the crosshair"
        )
        self.position_detail_var.set(self.position_detail)
        return
    self.position_calibration_samples.append((cx, cy, area_ratio))
    self.position_calibration_next_sample = now + V13_POSITION_CALIBRATION_SAMPLE_INTERVAL
    self.position_detail = (
        f"Collecting {len(self.position_calibration_samples)}/{V13_POSITION_CALIBRATION_FRAMES} stable frames..."
    )
    self.position_detail_var.set(self.position_detail)
    if len(self.position_calibration_samples) >= V13_POSITION_CALIBRATION_FRAMES:
        _v13_finish_position_calibration(self)


def _v13_position_gate(
    self: InspectionApp, frame: np.ndarray, update_ui: bool = True
) -> tuple[bool, Optional[tuple[int, int, int, int]], bool]:
    if self.position_calibration_active:
        self.position_ready = False
        self.position_bbox = None
        self.position_message = "POSITION: CALIBRATING"
        self.position_detail = f"Collecting {len(self.position_calibration_samples)}/{V13_POSITION_CALIBRATION_FRAMES} stable frames — HOLD STILL"
        if update_ui:
            self.position_gate_var.set(self.position_message)
            self.position_detail_var.set(self.position_detail)
        return False, None, False

    if self.position_calibration is None:
        self.position_ready = False
        self.position_bbox = None
        self.position_message = "POSITION: CALIBRATE FIRST"
        self.position_detail = "No global presentation calibration is loaded."
        if update_ui:
            self.position_gate_var.set(self.position_message)
            self.position_detail_var.set(self.position_detail)
        return False, None, False

    measurement = _v13_position_measurement(self, frame)
    roi = crop_roi(frame, self.roi)
    gray = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
    stable_diff = (
        0.0
        if self.position_previous_gray is None
        else (_pf2 if (_pf2 := _safe_absdiff_mean(gray, self.position_previous_gray)) is not None else 0.0)
    )
    self.position_previous_gray = gray
    stable = stable_diff <= V13_POSITION_STABLE_DIFF

    if measurement is None:
        self.position_ready = False
        self.position_bbox = None
        self.position_message = "POSITION: OBJECT NOT DETECTED"
        self.position_detail = "Place the object inside the yellow ROI and center it on the crosshair."
    else:
        cx, cy, area_ratio, bbox = measurement
        self.position_bbox = bbox
        tx = float(self.position_calibration.get("target_center_x", 0.5))
        ty = float(self.position_calibration.get("target_center_y", 0.5))
        tolx = float(self.position_calibration.get("tolerance_x", V13_POSITION_TOL_X))
        toly = float(self.position_calibration.get("tolerance_y", V13_POSITION_TOL_Y))
        dx = cx - tx
        dy = cy - ty
        center_ok = abs(dx) <= tolx and abs(dy) <= toly
        size_ok = not (area_ratio < V13_POSITION_TOO_SMALL_AREA or area_ratio > V13_POSITION_TOO_LARGE_AREA)

        if not center_ok:
            if dx < -tolx:
                self.position_message = "MOVE RIGHT"
            elif dx > tolx:
                self.position_message = "MOVE LEFT"
            elif dy < -toly:
                self.position_message = "MOVE DOWN"
            else:
                self.position_message = "MOVE UP"
            self.position_detail = f"Center=({cx:.2f},{cy:.2f}) | target=(0.50,0.50) | dx={dx:+.2f} dy={dy:+.2f}"
        elif not size_ok:
            if area_ratio < V13_POSITION_TOO_SMALL_AREA:
                self.position_message = "MOVE CLOSER"
                self.position_detail = f"Object is very small in ROI (area={area_ratio:.3f}). This is a broad safety check, shared by all products."
            else:
                self.position_message = "MOVE FARTHER"
                self.position_detail = f"Object is very large in ROI (area={area_ratio:.3f}). This is a broad safety check, shared by all products."
        elif not stable:
            self.position_message = "HOLD STILL"
            self.position_detail = f"Center OK | frame difference={stable_diff:.2f} (limit {V13_POSITION_STABLE_DIFF:.2f})"
        else:
            self.position_message = "POSITION: READY"
            self.position_detail = f"CENTER ✓ | SIZE ✓ | STABLE ✓ | bbox={bbox}"
        self.position_ready = bool(center_ok and size_ok and stable)

    if update_ui:
        self.position_gate_var.set(self.position_message)
        self.position_detail_var.set(self.position_detail)
    return self.position_ready, self.position_bbox, stable


def _v13_setup_position_state(self: InspectionApp) -> None:
    self.position_calibration: Optional[dict] = None
    self.position_calibration_active = False
    self.position_calibration_until = 0.0
    self.position_calibration_next_sample = 0.0
    self.position_calibration_samples: list[tuple[float, float, float]] = []
    self.position_calibration_previous_gray: Optional[np.ndarray] = None
    self.position_bbox: Optional[tuple[int, int, int, int]] = None
    self.position_ready = False
    self.position_message = "POSITION: CALIBRATE FIRST"
    self.position_detail = ""
    self.position_previous_gray: Optional[np.ndarray] = None
    self.last_inference_bbox: Optional[tuple[int, int, int, int]] = None


def _v13_add_position_panels(self: InspectionApp) -> None:
    # Add compact panels into the existing scrollable sidebars without changing
    # the proven V10 layout around camera/model/training controls.
    for tab_name, title in (("TRAINING", "CAMERA POSITION / PRESENTATION"), ("MONITORING", "CAMERA POSITION GATE")):
        tab = self.tabs.tab(tab_name)
        panel = _v13_find_scrollable(tab)
        if panel is None:
            continue
        frame = ctk.CTkFrame(panel)
        frame.pack(fill="x", padx=10, pady=8)
        ctk.CTkLabel(frame, text=title, font=ctk.CTkFont(size=17, weight="bold")).pack(
            anchor="w", padx=10, pady=(8, 4)
        )
        ctk.CTkLabel(
            frame,
            text=(
                "One GLOBAL calibration is shared by every product. Place a GOOD part on the "
                "center crosshair and HOLD STILL. After saving, no product-specific distance "
                "calibration is required."
            ),
            wraplength=370, justify="left"
        ).pack(fill="x", padx=10, pady=(0, 5))
        ctk.CTkLabel(frame, textvariable=self.calibration_var, wraplength=370, justify="left").pack(
            fill="x", padx=10, pady=2
        )
        ctk.CTkLabel(frame, textvariable=self.position_gate_var, wraplength=370, justify="left",
                     font=ctk.CTkFont(size=16, weight="bold")).pack(fill="x", padx=10, pady=2)
        ctk.CTkLabel(frame, textvariable=self.position_detail_var, wraplength=370, justify="left").pack(
            fill="x", padx=10, pady=(2, 5)
        )
        ctk.CTkButton(frame, text="CALIBRATE GLOBAL POSITION", height=40,
                      command=self.start_position_calibration).pack(fill="x", padx=10, pady=3)
