    # -------------------------------------------------------------------------
    # Product dataset helpers
    # -------------------------------------------------------------------------
    @staticmethod
    def product_directory(name: str) -> Path:
        return DATASET_ROOT / sanitize_product_directory(name)

    def list_product_names(self) -> list[str]:
        names: list[str] = []
        if not DATASET_ROOT.exists():
            return names
        for directory in sorted(DATASET_ROOT.iterdir(), key=lambda p: p.name.lower()):
            if not directory.is_dir():
                continue
            good = directory / "good"
            if not good.is_dir():
                continue
            meta = directory / "product.json"
            display_name = directory.name
            if meta.exists():
                try:
                    data = json.loads(meta.read_text(encoding="utf-8"))
                    display_name = str(data.get("name", display_name))
                except Exception:
                    pass
            names.append(display_name)
        return names

    def ensure_product(self, name: str) -> tuple[str, Path]:
        clean = (name or "").strip()
        if not clean:
            raise ValueError("Enter a product name first.")
        directory_name = sanitize_product_directory(clean)
        product_dir = DATASET_ROOT / directory_name
        good_dir = product_dir / "good"
        good_dir.mkdir(parents=True, exist_ok=True)
        (product_dir / "product.json").write_text(
            json.dumps({"name": clean, "directory_name": directory_name}, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )
        return clean, product_dir

    def selected_product_name(self) -> str:
        name = self.product_combo_var.get().strip() or self.product_name_var.get().strip()
        return name

    def product_files(self, name: str) -> list[Path]:
        product_dir = self.product_directory(name)
        good_dir = product_dir / "good"
        if not good_dir.exists():
            return []
        return sorted(
            [p for p in good_dir.iterdir() if p.suffix.lower() in VALID_IMAGE_EXTENSIONS],
            key=lambda p: p.name.lower(),
        )

    @staticmethod
    def sanitize_defect_name(name: str) -> str:
        cleaned = (name or "").strip()
        cleaned = re.sub(r'[<>:"/\\|?*\x00-\x1F]', "_", cleaned)
        cleaned = cleaned.rstrip(" .")
        return cleaned[:80] if cleaned else "defect"

    def defect_root(self, product_name: str) -> Path:
        return self.product_directory(product_name) / "defects"

    def defect_directory(self, product_name: str, defect_name: str) -> Path:
        return self.defect_root(product_name) / self.sanitize_defect_name(defect_name)

    def list_defect_types(self, product_name: str) -> list[str]:
        root = self.defect_root(product_name)
        if not root.exists():
            return []
        return sorted([p.name for p in root.iterdir() if p.is_dir()], key=lambda p: p.lower())

    def defect_files(self, product_name: str, defect_name: str) -> list[Path]:
        folder = self.defect_directory(product_name, defect_name)
        if not folder.exists():
            return []
        return sorted(
            [p for p in folder.rglob("*") if p.is_file() and p.suffix.lower() in VALID_IMAGE_EXTENSIONS],
            key=lambda p: str(p).lower(),
        )

    def ensure_defect(self, product_name: str, defect_name: str) -> Path:
        if not product_name:
            raise ValueError("Create/select a product first.")
        clean = (defect_name or "").strip()
        if not clean:
            raise ValueError("Enter a defect name, for example NO_CAP or SCRATCH.")
        self.ensure_product(product_name)
        folder = self.defect_directory(product_name, clean)
        folder.mkdir(parents=True, exist_ok=True)
        return folder

    def refresh_defect_combo(self) -> None:
        product = self.selected_product_name()
        names = self.list_defect_types(product) if product else []
        if self.defect_combo is not None:
            self.defect_combo.configure(values=names if names else ["<No defects yet>"])
        current = self.training_defect_combo_var.get().strip()
        if current not in names:
            current = names[0] if names else ""
            self.training_defect_combo_var.set(current)
        self.training_defect_var.set(current)
        counts = [f"{name}: {len(self.defect_files(product, name))}" for name in names] if product else []
        self.defect_info_var.set(
            (f"Selected defect: {current}\n" if current else "No defect selected.\n") +
            (f"{len(self.defect_files(product, current))} image(s)" if current and product else "Enter/create a defect name to start.") +
            ("\n\n" + "\n".join(counts) if counts else "")
        )

    def select_defect_from_combo(self, value: str) -> None:
        if value == "<No defects yet>":
            self.training_defect_combo_var.set("")
            self.training_defect_var.set("")
        else:
            self.training_defect_combo_var.set(value)
            self.training_defect_var.set(value)
        self.refresh_defect_combo()

    def create_or_select_defect(self) -> None:
        try:
            product = self.selected_product_name()
            defect = self.training_defect_var.get().strip()
            self.ensure_defect(product, defect)
            self.training_defect_combo_var.set(self.sanitize_defect_name(defect))
            self.training_defect_var.set(self.sanitize_defect_name(defect))
            self.refresh_defect_combo()
            self.status_var.set(f"Defect training target selected: {defect} for {product}")
        except Exception as exc:
            messagebox.showerror("Defect", str(exc))

    def refresh_product_combo(self) -> None:
        names = self.list_product_names()
        if self.product_combo is not None:
            self.product_combo.configure(values=names if names else ["<No products yet>"])
        current = self.product_combo_var.get().strip()
        if current not in names:
            current = names[0] if names else ""
            self.product_combo_var.set(current)
        self.product_name_var.set(current)
        self.product_list_var.set(
            "Products: " + (", ".join(names) if names else "none yet")
        )
        self.refresh_training_info()
        self.refresh_defect_combo()

    def select_product_from_combo(self, value: str) -> None:
        if value == "<No products yet>":
            self.product_combo_var.set("")
            self.product_name_var.set("")
            self.refresh_training_info()
            self.refresh_defect_combo()
            return
        self.product_combo_var.set(value)
        self.product_name_var.set(value)
        self.refresh_training_info()
        self.refresh_defect_combo()

    def create_or_select_product(self) -> None:
        try:
            name, _ = self.ensure_product(self.product_name_var.get())
            self.product_combo_var.set(name)
            self.refresh_product_combo()
            self.product_combo_var.set(name)
            self.product_name_var.set(name)
            self.refresh_training_info()
            self.refresh_defect_combo()
            self.status_var.set(f"Training target selected: {name}")
        except Exception as exc:
            messagebox.showerror("Product", str(exc))

    def refresh_training_info(self) -> None:
        name = self.selected_product_name()
        if not name:
            self.training_info_var.set(
                "No product selected. Enter a product name and press CREATE / SELECT PRODUCT."
            )
            return
        count = len(self.product_files(name))
        self.training_info_var.set(
            f"Selected product: {name}\n"
            f"GOOD images: {count}\n"
            f"Minimum: {TRAIN_MINIMUM} | Recommended: {RECOMMENDED_PER_PRODUCT}+\n"
            "Important: these images belong ONLY to this product."
        )
        if self.progress_bar is not None and not self.training_model_running:
            self.progress_bar.set(min(1.0, count / max(1, RECOMMENDED_PER_PRODUCT)))

