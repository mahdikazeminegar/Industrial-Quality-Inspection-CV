    def _refresh_port_list(self) -> None:
        ports = ["AUTO"] + ESP32Controller.available_ports()
        if self.esp_combo is not None:
            self.esp_combo.configure(values=ports)
            if self.port_var.get() not in ports:
                self.port_var.set("AUTO")

    def connect_esp(self) -> None:
        ok, message = self.esp.connect(self.port_var.get())
        self.esp_status_var.set(message)
        if ok:
            try:
                stats = self.db.analytics()
                self.esp.send_stats(stats["total"], stats["passed"], stats["failed"], stats["avg_cycle_ms"])
            except Exception:
                pass
        self.arduino_transfer_var.set("Arduino HMI: ready" if ok else "Arduino HMI: waiting for connection")
        self.status_var.set(message)

    def send_last_result_to_arduino(self) -> None:
        if self.last_result_overlay is None:
            messagebox.showwarning("Arduino", "There is no inspection result yet.")
            return
        status = self.result_var.get().replace("RESULT:", "", 1).strip() or "FAIL"
        product = self.product_var.get().replace("PRODUCT:", "", 1).strip() or "UNKNOWN_PRODUCT"
        defect = self.defect_var.get().replace("DEFECT:", "", 1).strip() or "UNKNOWN_DEFECT"
        ok = self.esp.send_result(status, product, defect, self.last_cycle_ms)
        self.arduino_transfer_var.set("Arduino HMI: last result sent" if ok else "Arduino HMI: not connected")
        if not ok:
            messagebox.showwarning("Arduino", "Connect Arduino UNO first.")

    def apply_roi(self) -> None:
        try:
            new_roi = (
                int(self.roi_x_var.get()),
                int(self.roi_y_var.get()),
                int(self.roi_w_var.get()),
                int(self.roi_h_var.get()),
            )
            if new_roi[2] < 20 or new_roi[3] < 20:
                raise ValueError("Width/height must be at least 20 pixels.")
            self.roi = new_roi
            self.background_gray = None
            self.previous_gray = None
            self.status_var.set(f"Shared ROI applied: {self.roi}")
        except ValueError as exc:
            messagebox.showerror("ROI", f"Invalid ROI:\n{exc}")

    def _draw_roi(self, frame: np.ndarray, title: str) -> np.ndarray:
        out = frame.copy()
        x, y, w, h = self.roi
        hh, ww = out.shape[:2]
        x = max(0, min(x, max(0, ww - 1)))
        y = max(0, min(y, max(0, hh - 1)))
        w = max(10, min(w, max(10, ww - x)))
        h = max(10, min(h, max(10, hh - y)))
        cv2.rectangle(out, (x, y), (x + w, y + h), (0, 255, 255), 2)
        cv2.putText(
            out,
            title,
            (max(10, x), max(25, y - 8)),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.60,
            (0, 255, 255),
            2,
            cv2.LINE_AA,
        )
        return out

    def _frame_to_tk(self, widget: ctk.CTkLabel, frame: np.ndarray, width: int = 940, height: int = 690) -> None:
        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        image = Image.fromarray(rgb)
        image.thumbnail((width, height), Image.Resampling.LANCZOS)
        photo = ImageTk.PhotoImage(image=image)
        widget.configure(image=photo, text="")
        widget.image = photo

    def _update_training_video(self, frame: np.ndarray) -> None:
        if self.training_video_label is None:
            return
        display = self._draw_roi(frame, "TRAINING ROI — ONLY SELECTED GOOD PRODUCT")
        if self.training_auto:
            remaining = max(0.0, self.training_auto_until - time.monotonic())
            cv2.putText(
                display,
                f"AUTO {remaining:05.1f}s",
                (18, 32),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.70,
                (0, 255, 255),
                2,
                cv2.LINE_AA,
            )
            count = len(self._training_files()) - self.training_start_count
            cv2.putText(
                display,
                f"CAPTURED THIS SESSION: {max(0, count)}",
                (18, 58),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.58,
                (0, 255, 255),
                2,
                cv2.LINE_AA,
            )
        if time.monotonic() < self.training_flash_until:
            cv2.rectangle(display, (5, 5), (display.shape[1] - 5, display.shape[0] - 5), (0, 255, 0), 4)
            cv2.putText(
                display,
                "GOOD SAMPLE CAPTURED",
                (20, display.shape[0] - 20),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.80,
                (0, 255, 0),
                2,
                cv2.LINE_AA,
            )
        self._frame_to_tk(self.training_video_label, display)

    def _update_monitor_video(self, frame: np.ndarray) -> None:
        if self.video_label is None:
            return
        display = self._draw_roi(frame, "INSPECTION ROI")
        if self.last_result_overlay is not None and time.monotonic() - self.last_result_at < 2.5:
            x, y, w, h = self.roi
            hframe, wframe = display.shape[:2]
            x = max(0, min(x, max(0, wframe - 1)))
            y = max(0, min(y, max(0, hframe - 1)))
            w = max(10, min(w, max(10, wframe - x)))
            h = max(10, min(h, max(10, hframe - y)))
            overlay = cv2.resize(self.last_result_overlay, (w, h), interpolation=cv2.INTER_AREA)
            display[y:y + h, x:x + w] = overlay
        self._frame_to_tk(self.video_label, display)

