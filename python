    # -------------------------------------------------------------------------
    # Camera
    # -------------------------------------------------------------------------
    def _open_camera(self) -> None:
        self._release_camera()
        try:
            index = int(self.camera_var.get().strip())
        except ValueError:
            index = CAMERA_INDEX
            self.camera_var.set(str(CAMERA_INDEX))

        # Windows backends differ between webcams/drivers. Try DirectShow first,
        # then Media Foundation as a fallback.
        if os.name == "nt":
            cap = cv2.VideoCapture(index, cv2.CAP_DSHOW)
            if not cap.isOpened():
                try:
                    cap.release()
                except Exception:
                    pass
                cap = cv2.VideoCapture(index, cv2.CAP_MSMF)
        else:
            cap = cv2.VideoCapture(index)

        if not cap.isOpened():
            try:
                cap.release()
            except Exception:
                pass
            self.camera_state_var.set(f"Camera: cannot open index {index}")
            self.status_var.set(f"Camera {index} could not be opened. Try another camera index and click REOPEN.")
            return
        # Request the user's configured size, but never assume the driver will honor it exactly.
        cap.set(cv2.CAP_PROP_FRAME_WIDTH, int(CAMERA_WIDTH))
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, int(CAMERA_HEIGHT))
        cap.set(cv2.CAP_PROP_FPS, int(CAMERA_FPS))

        # Flush a few stale/renegotiation frames after reopening. Several Windows
        # webcam drivers can return one or more frames with the previous format.
        try:
            for _ in range(6):
                cap.grab()
        except Exception:
            pass

        self.cap = cap
        self.camera_running = True

        # Reset ALL buffers that can participate in arithmetic with a camera ROI.
        # This is intentionally broader than the old reset because the ROI shape
        # can remain identical even when the underlying webcam format changed.
        self.background_gray = None
        self.previous_gray = None
        self.event_background_gray = None
        self.last_inspected_gray = None
        self.last_inference_roi = None
        self.last_inference_bbox = None
        self.position_previous_gray = None
        self.position_calibration_previous_gray = None
        self.training_capture_background = None
        self.training_capture_previous = None
        self._last_camera_roi_shape = None
        self._last_camera_frame_shape = None
        self.trigger_state = "ARMED"
        self.stable_counter = 0
        self.remove_counter = 0
        self.replacement_counter = 0

        actual_w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH) or 0)
        actual_h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT) or 0)
        self.camera_state_var.set(
            f"Camera: OPEN (requested {CAMERA_WIDTH}x{CAMERA_HEIGHT}, actual {actual_w}x{actual_h})"
        )
        self.status_var.set(f"Camera {index} opened. Same camera is shared by Training and Monitoring.")

    def _reopen_camera(self) -> None:
        self._open_camera()

    def _release_camera(self) -> None:
        self.camera_running = False
        if self.cap is not None:
            try:
                self.cap.release()
            except Exception:
                pass
        self.cap = None

    # -------------------------------------------------------------------------
    # Camera loop + sensors
    # -------------------------------------------------------------------------
    def _camera_loop(self) -> None:
        # Keep the Tk timer alive even when OpenCV raises an exception.
        # A callback exception can otherwise make the live preview appear
        # frozen even though the camera itself was opened successfully.
        try:
            if self.camera_running and self.cap is not None:
                ok, frame = self.cap.read()
                if ok and frame is not None and frame.size > 0:
                    with self.frame_lock:
                        self.current_frame = frame.copy()
                    # Some Windows webcam drivers do not honor the requested
                    # resolution exactly and can briefly renegotiate it.
                    # Reset all shape-dependent buffers before image arithmetic.
                    roi_now = crop_roi(frame, self.roi)
                    roi_shape = roi_now.shape[:2]
                    if getattr(self, "_last_camera_frame_shape", None) != frame.shape[:2]:
                        self._last_camera_frame_shape = frame.shape[:2]
                        self._last_camera_roi_shape = roi_shape
                        self.background_gray = None
                        self.previous_gray = None
                        self.event_background_gray = None
                        self.last_inspected_gray = None
                        self.last_inference_roi = None
                        self.last_inference_bbox = None
                        self.position_previous_gray = None
                        self.position_calibration_previous_gray = None
                        self.training_capture_background = None
                        self.training_capture_previous = None
                        fh, fw = frame.shape[:2]
                        requested = f"{CAMERA_WIDTH}x{CAMERA_HEIGHT}"
                        actual = f"{fw}x{fh}"
                        self.camera_state_var.set(
                            f"Camera: OPEN (requested {requested}, actual {actual})"
                        )
                    self._process_camera_state(frame)
                    self._update_training_video(frame)
                    self._update_monitor_video(frame)
                else:
                    self.camera_state_var.set("Camera: frame read failed")
                    self.status_var.set("Camera opened but a frame could not be read.")
        except cv2.error as exc:
            self.camera_state_var.set("Camera: OpenCV error")
            self.status_var.set(f"OpenCV camera error: {exc}")
        except Exception as exc:
            self.camera_state_var.set("Camera: runtime error")
            self.status_var.set(f"Camera loop error: {exc}")
        finally:
            self.after(30, self._camera_loop)

    def _process_camera_state(self, frame: np.ndarray) -> None:
        if self.training_auto and not self.monitoring:
            self._process_training_auto(frame)

        ratio, mean_diff, present, absent, stable = self._sensor_state(frame)
        if not self.monitoring:
            if absent and self.background_gray is not None:
                # Slowly adapt only while the ROI is known to be empty.
                roi = crop_roi(frame, self.roi)
                gray = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
                if self.background_gray.shape == gray.shape:
                    self.background_gray = _safe_add_weighted(
                        self.background_gray, gray, 1.0 - BACKGROUND_ALPHA, BACKGROUND_ALPHA
                    )
                else:
                    self.background_gray = gray.copy()
            self.trigger_state = "ARMED"
            self._update_sensor_label()
            return

        # Never overwrite the INFERENCE state while a worker is running.
        if self.trigger_state == "INFERENCE" or self.inference_in_progress:
            self.monitor_event_var.set("Event: AI identification + anomaly inspection running...")
            self._update_sensor_label()
            return

        if self.trigger_state == "ARMED":
            self.monitor_event_var.set("Event: ARMED — waiting for a product")
            if present:
                self.trigger_state = "WAIT_STABLE"
                self.trigger_started_at = time.monotonic()
                self.stable_counter = 0
                self.remove_counter = 0
                self.replacement_counter = 0
                if self.background_gray is not None:
                    self.event_background_gray = self.background_gray.copy()

        elif self.trigger_state == "WAIT_STABLE":
            self.monitor_event_var.set("Event: product detected — waiting for stable image")
            if not present:
                self.trigger_state = "ARMED"
                self.stable_counter = 0
            else:
                self.stable_counter = self.stable_counter + 1 if stable else 0
                if (
                    time.monotonic() - self.trigger_started_at >= SETTLE_DELAY_SEC
                    and self.stable_counter >= STABLE_FRAMES_REQUIRED
                ):
                    roi = crop_roi(frame, self.roi)
                    self.last_inference_roi = roi.copy()
                    self._schedule_inference(roi, manual=False)

        elif self.trigger_state == "WAIT_REMOVE":
            elapsed = time.monotonic() - self.wait_remove_started_at
            self.monitor_event_var.set(
                "Event: inspection complete — remove product or place the next part"
            )

            # Preferred path: ROI returns to the pre-trigger background.
            if absent:
                self.remove_counter += 1
            else:
                self.remove_counter = 0

            if self.remove_counter >= REMOVE_FRAMES_REQUIRED:
                roi = crop_roi(frame, self.roi)
                gray = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
                self.background_gray = gray.copy()
                self.previous_gray = gray.copy()
                self.event_background_gray = None
                self.last_inspected_gray = None
                self.remove_counter = 0
                self.replacement_counter = 0
                self.trigger_state = "ARMED"
                self.monitor_event_var.set("Event: product removed — sensor ARMED for next part")

            # Secondary path for conveyor / replacement without a clean empty frame:
            # only retrigger when a stable image is substantially different from the last inspected part.
            elif (
                self.last_inspected_gray is not None
                and stable
                and elapsed >= REPLACEMENT_MIN_GAP_SEC
            ):
                roi = crop_roi(frame, self.roi)
                gray = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
                change = _safe_absdiff_mean(gray, self.last_inspected_gray)
            if change is None:
                change = 0.0
                if change >= REPLACEMENT_DIFF_MEAN:
                    self.replacement_counter += 1
                else:
                    self.replacement_counter = 0
                if self.replacement_counter >= REPLACEMENT_STABLE_FRAMES:
                    self.replacement_counter = 0
                    self.last_inference_roi = roi.copy()
                    self._schedule_inference(roi, manual=False)

            # Fail-safe recovery if the ROI never returns to empty.
            if elapsed >= MAX_WAIT_REMOVE_SEC and not self.inference_in_progress:
                roi = crop_roi(frame, self.roi)
                gray = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
                if not present:
                    self.background_gray = gray.copy()
                    self.previous_gray = gray.copy()
                    self.trigger_state = "ARMED"
                    self.wait_remove_started_at = 0.0
                else:
                    # Keep waiting rather than repeatedly inspecting a stationary part.
                    self.wait_remove_started_at = time.monotonic()

        self._update_sensor_label()

    def _sensor_state(self, frame: np.ndarray) -> tuple[float, float, bool, bool, bool]:
        roi = crop_roi(frame, self.roi)
        gray = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
        if self.background_gray is None or self.background_gray.shape != gray.shape:
            self.background_gray = gray.copy()
            self.previous_gray = gray.copy()
            self.last_motion_ratio = 0.0
            self.last_frame_diff = 0.0
            return 0.0, 0.0, False, True, True

        bg_diff = _safe_absdiff(gray, self.background_gray)
        if bg_diff is None:
            self.background_gray = gray.copy()
            self.previous_gray = gray.copy()
            self.last_motion_ratio = 0.0
            self.last_frame_diff = 0.0
            return 0.0, 0.0, False, True, True
        ratio = float(np.mean(bg_diff >= MOTION_PIXEL_THRESHOLD))
        mean_diff = float(np.mean(bg_diff))
        _fd = _safe_absdiff_mean(gray, self.previous_gray)
        frame_diff = 0.0 if _fd is None else _fd

        # Use both area-ratio and mean-intensity change, because one can fail when
        # the product is uniform or when lighting changes slightly.
        present = (ratio >= MOTION_ON_RATIO) or (mean_diff >= MOTION_MEAN_ON)
        absent = (ratio <= MOTION_OFF_RATIO) and (mean_diff <= MOTION_MEAN_OFF)
        stable = frame_diff <= FRAME_DIFF_STABLE

        self.last_motion_ratio = ratio
        self.last_frame_diff = frame_diff
        self.previous_gray = gray

        return ratio, mean_diff, present, absent, stable

    # -------------------------------------------------------------------------
    # Training capture
    # -------------------------------------------------------------------------
    def _training_capture_state(self, frame: np.ndarray) -> tuple[bool, bool]:
        roi = crop_roi(frame, self.roi)
        gray = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
        if self.training_capture_background is None or self.training_capture_background.shape != gray.shape:
            self.training_capture_background = gray.copy()
        _db = _safe_absdiff_mean(gray, self.training_capture_background)
        if _db is None:
            self.training_capture_background = gray.copy()
            _db = 0.0
        diff_to_bg = _db
        present = diff_to_bg >= 4.5
        _tf = _safe_absdiff_mean(gray, self.training_capture_previous)
        frame_diff = 0.0 if _tf is None else _tf
        stable = frame_diff <= FRAME_DIFF_STABLE
        self.training_capture_previous = gray
        return present, stable

    def _training_files(self) -> list[Path]:
        name = self.selected_product_name()
        return self.product_files(name) if name else []

    def _current_capture_files(self) -> list[Path]:
        name = self.selected_product_name()
        if not name:
            return []
        if self.training_capture_kind == "DEFECT":
            defect = self.training_defect_name or self.training_defect_var.get().strip()
            return self.defect_files(name, defect) if defect else []
        return self.product_files(name)

    def _save_training_sample(self, frame: np.ndarray) -> bool:
        name = self.selected_product_name()
        if not name:
            return False
        roi = crop_roi(frame, self.roi)
        if self.training_capture_kind == "DEFECT":
            defect = self.training_defect_name or self.training_defect_var.get().strip()
            if not defect:
                return False
            defect_dir = self.ensure_defect(name, defect)
            path = defect_dir / f"defect_{timestamp_for_file()}.jpg"
        else:
            _, product_dir = self.ensure_product(name)
            path = product_dir / "good" / f"good_{timestamp_for_file()}.jpg"
        return bool(cv2.imwrite(str(path), roi, [cv2.IMWRITE_JPEG_QUALITY, 95]))

    def capture_one_good(self) -> None:
        if self.monitoring or self.training_model_running or self.training_auto:
            messagebox.showwarning("Training", "Stop monitoring/auto capture/model training first.")
            return
        try:
            self.training_capture_kind = "GOOD"
            self.ensure_product(self.selected_product_name())
        except Exception as exc:
            messagebox.showerror("Product", str(exc))
            return
        with self.frame_lock:
            frame = None if self.current_frame is None else self.current_frame.copy()
        if frame is None:
            messagebox.showwarning("Training", "Camera frame is not available.")
            return
        if self._save_training_sample(frame):
            self.training_flash_until = time.monotonic() + 0.5
            self.refresh_training_info()
            self.status_var.set(f"One GOOD sample added to {self.selected_product_name()}.")

    def capture_one_defect(self) -> None:
        if self.monitoring or self.training_model_running or self.training_auto:
            messagebox.showwarning("Defect training", "Stop monitoring/auto capture/model training first.")
            return
        product = self.selected_product_name()
        defect = self.training_defect_var.get().strip() or self.training_defect_combo_var.get().strip()
        if not product:
            messagebox.showwarning("Defect training", "Create/select a product first.")
            return
        if not defect:
            messagebox.showwarning("Defect training", "Enter/select a defect name first, e.g. NO_CAP.")
            return
        try:
            self.training_capture_kind = "DEFECT"
            self.training_defect_name = self.sanitize_defect_name(defect)
            self.ensure_defect(product, self.training_defect_name)
        except Exception as exc:
            messagebox.showerror("Defect", str(exc))
            return
        with self.frame_lock:
            frame = None if self.current_frame is None else self.current_frame.copy()
        if frame is None:
            messagebox.showwarning("Defect training", "Camera frame is not available.")
            return
        if self._save_training_sample(frame):
            self.training_defect_flash_until = time.monotonic() + 0.5
            self.refresh_defect_combo()
            self.status_var.set(f"One '{self.training_defect_name}' defect sample added to {product}.")

    def _start_auto_capture(self, kind: str) -> None:
        if self.monitoring:
            messagebox.showwarning("Training", "Stop MONITORING first.")
            return
        if self.training_model_running:
            messagebox.showwarning("Training", "Model training is running.")
            return
        product_name = self.selected_product_name()
        if not product_name:
            messagebox.showwarning(
                "Training product required",
                "Enter the product name and press CREATE / SELECT PRODUCT first."
            )
            return
        if kind == "DEFECT":
            defect = self.training_defect_var.get().strip() or self.training_defect_combo_var.get().strip()
            if not defect:
                messagebox.showwarning("Defect training", "Enter/select a defect name first, e.g. NO_CAP.")
                return
            try:
                self.training_defect_name = self.sanitize_defect_name(defect)
                self.ensure_defect(product_name, self.training_defect_name)
            except Exception as exc:
                messagebox.showerror("Defect", str(exc))
                return
        else:
            self.ensure_product(product_name)
            self.training_defect_name = ""
        try:
            duration = float(self.training_duration_var.get().strip())
            if not (5.0 <= duration <= 3600.0):
                raise ValueError
        except ValueError:
            messagebox.showerror("Timer", "Enter a timer between 5 and 3600 seconds.")
            return
        with self.frame_lock:
            frame = None if self.current_frame is None else self.current_frame.copy()
        if frame is None:
            messagebox.showwarning("Training", "Camera frame is not available yet.")
            return
        roi = crop_roi(frame, self.roi)
        self.training_capture_background = cv2.GaussianBlur(cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY), (5, 5), 0)
        self.training_capture_previous = None
        self.training_capture_kind = kind
        self.training_auto = True
        self.training_auto_until = time.monotonic() + duration
        self.training_auto_next_capture = time.monotonic() + 0.7
        self.training_start_count = len(self._current_capture_files())
        self.training_timer_var.set(f"AUTO TIMER: {duration:05.1f} s")
        target = product_name if kind == "GOOD" else f"{product_name} / {self.training_defect_name}"
        label = "GOOD" if kind == "GOOD" else "DEFECT"
        self.training_state_var.set(f"Training: AUTO {label} CAPTURE — {target}")
        self.status_var.set(
            f"AUTO {label} CAPTURE started. Keep ONLY {target} in the ROI during this session."
        )

    def start_auto_capture(self) -> None:
        self._start_auto_capture("GOOD")

    def start_auto_defect_capture(self) -> None:
        self._start_auto_capture("DEFECT")

    def _process_training_auto(self, frame: np.ndarray) -> None:
        if not self.training_auto:
            return
        now = time.monotonic()
        if now >= self.training_auto_until:
            self.stop_auto_capture(auto_finished=True)
            return
        remaining = max(0.0, self.training_auto_until - now)
        self.training_timer_var.set(f"AUTO TIMER: {remaining:05.1f} s")
        current_count = len(self._current_capture_files())
        captured_this_session = current_count - self.training_start_count
        if captured_this_session >= TRAIN_MAX_NEW_SAMPLES:
            self.stop_auto_capture(auto_finished=True)
            return
        present, stable = self._training_capture_state(frame)
        if present and stable and now >= self.training_auto_next_capture:
            if self._save_training_sample(frame):
                self.training_auto_next_capture = now + TRAIN_CAPTURE_INTERVAL_SEC
                self.training_flash_until = now + 0.35
                self.training_defect_flash_until = now + 0.35 if self.training_capture_kind == "DEFECT" else 0.0
                if self.training_capture_kind == "DEFECT":
                    self.refresh_defect_combo()
                    label = self.training_defect_name
                else:
                    self.refresh_training_info()
                    label = "GOOD"
                self.training_state_var.set(
                    f"Training: {label} — sample {captured_this_session + 1}"
                )

    def stop_auto_capture(self, auto_finished: bool = False) -> None:
        was_running = self.training_auto
        kind = self.training_capture_kind
        target = self.training_defect_name if kind == "DEFECT" else self.selected_product_name()
        self.training_auto = False
        self.training_capture_background = None
        self.training_capture_previous = None
        self.training_timer_var.set("AUTO TIMER: OFF")
        if was_running:
            count = len(self._current_capture_files())
            label = "DEFECT" if kind == "DEFECT" else "GOOD"
            self.training_state_var.set("Training: CAPTURE FINISHED")
            self.refresh_training_info()
            self.refresh_defect_combo()
            self.status_var.set(f"Auto {label.lower()} capture finished for '{target}'. {count} total image(s) in this target.")
        self.training_capture_kind = "GOOD"
        self.training_defect_name = ""

    def clear_selected_product(self) -> None:
        if self.training_auto or self.training_model_running or self.monitoring:
            messagebox.showwarning("Dataset", "Stop capture/monitoring/training first.")
            return
        name = self.selected_product_name()
        if not name:
            messagebox.showwarning("Dataset", "Select a product first.")
            return
        files = self.product_files(name)
        if not files:
            return
        if not messagebox.askyesno(
            "Clear selected product",
            f"Delete {len(files)} GOOD image(s) for '{name}'?\n\nOther products will NOT be touched."
        ):
            return
