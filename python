# Inference thread now forwards the validated bbox so Identity/PatchCore/Defect
# all consume the exact same canonical view.
def _v13_schedule_inference(
    self: InspectionApp,
    roi: np.ndarray,
    manual: bool,
    validated_bbox: Optional[tuple[int, int, int, int]] = None,
) -> None:
    if self.model is None:
        self.monitor_event_var.set("Event: no V10-compatible model set loaded")
        return
    if self.inference_in_progress:
        return
    self.inference_in_progress = True
    if not manual:
        self.last_inference_roi = roi.copy()
        self.last_inference_bbox = tuple(validated_bbox) if validated_bbox is not None else None
        self.trigger_state = "INFERENCE"
        self.monitor_event_var.set("Event: AI identification + anomaly inspection running...")
    else:
        self.monitor_event_var.set("Event: manual AI identification + anomaly inspection running...")
    model = self.model
    threading.Thread(
        target=_v13_inference_worker,
        args=(self, model, roi.copy(), manual, validated_bbox),
        daemon=True,
    ).start()


def _v13_inference_worker(
    self: InspectionApp,
    model: LabeledProductModel,
    roi: np.ndarray,
    manual: bool,
    validated_bbox: Optional[tuple[int, int, int, int]],
) -> None:
    # Call V10's existing post-processing/UI callback by reproducing only the
    # model invocation portion; the result format is unchanged.
    try:
        (
            product_name,
            is_anomaly,
            anomaly_score,
            identity_distance,
            identity_threshold,
            heatmap,
            anomaly_threshold,
            identity_combined,
            defect_type,
            defect_probability,
            defect_margin,
        ) = model.predict(roi, validated_bbox=validated_bbox)

        # PASS means known product + no anomaly + no confirmed defect.
        # A user-defined defect that the classifier confidently recognizes is
        # always FAIL so it is highlighted and logged for review.
        confirmed_defect = (
            defect_type not in {
                "GOOD", "NONE", "NO_DEFECT_MODEL", "UNKNOWN_DEFECT",
                "UNKNOWN_ANOMALY", "UNKNOWN_OR_AMBIGUOUS_PRODUCT"
            }
            and defect_probability >= DEFECT_MIN_PROB
        )
        if product_name == "UNKNOWN PRODUCT":
            status = "FAIL"
            display_score = 0.0
            defect_type = "UNKNOWN_OR_AMBIGUOUS_PRODUCT"
        elif confirmed_defect:
            status = "FAIL"
            display_score = anomaly_score
        elif is_anomaly:
            status = "FAIL"
            display_score = anomaly_score
            if defect_type in {"GOOD", "NONE", "NO_DEFECT_MODEL", "UNKNOWN_DEFECT"}:
                defect_type = "UNKNOWN_ANOMALY"
        else:
            status = "PASS"
            display_score = anomaly_score
            if defect_type == "NO_DEFECT_MODEL":
                defect_type = "GOOD"

        overlay = self._make_result_overlay(
            roi,
            heatmap,
            status,
            product_name,
            defect_type,
            defect_probability,
            display_score,
            anomaly_threshold,
            identity_distance,
            identity_threshold,
            identity_combined,
        )
        folder = LOG_DIR / sanitize_product_directory(product_name) / datetime.now().strftime("%Y-%m-%d")
        folder.mkdir(parents=True, exist_ok=True)
        image_path = folder / f"{timestamp_for_file()}_{status}.jpg"
        cv2.imwrite(str(image_path), overlay)
        self.db.add(
            product_name, status, defect_type, display_score, anomaly_threshold,
            identity_distance, identity_threshold, defect_probability, defect_margin,
            str(image_path)
        )
        self.after(0, lambda: self._on_inference_result(
            status, product_name, defect_type, defect_probability, defect_margin,
            display_score, anomaly_threshold, identity_distance, identity_threshold,
            identity_combined, overlay, str(image_path), manual
        ))
    except Exception as exc:
        self.after(0, lambda error=exc: self._on_inference_error(error))


