        self.dashboard_defects_box.delete("1.0", "end")
        self.dashboard_defects_box.insert("end", "FAILURE / DEFECT BREAKDOWN\n")
        if stats["defects"]:
            for defect, count in stats["defects"]:
                self.dashboard_defects_box.insert("end", f"{defect:<30} {count:>6}\n")
        else:
            self.dashboard_defects_box.insert("end", "No FAIL records yet.\n")
        self.dashboard_defects_box.configure(state="disabled")

        self.dashboard_products_box.configure(state="normal")
        self.dashboard_products_box.delete("1.0", "end")
        self.dashboard_products_box.insert("end", "INSPECTIONS BY PRODUCT\n")
        if stats["products"]:
            for product, count in stats["products"]:
                self.dashboard_products_box.insert("end", f"{product:<30} {count:>6}\n")
        else:
            self.dashboard_products_box.insert("end", "No inspection records yet.\n")
        self.dashboard_products_box.configure(state="disabled")

        rows = list(reversed(self.db.recent(limit=30)))
        self.dashboard_recent_box.configure(state="normal")
        self.dashboard_recent_box.delete("1.0", "end")
        self.dashboard_recent_box.insert("end", "ID    STATUS  PRODUCT                 DEFECT                 CYCLE   TIME\n")
        self.dashboard_recent_box.insert("end", "----  ------  ----------------------  ---------------------  ------  -------------------\n")
        for row in rows:
            rid, product, status, defect, _score, _thr, _id_dist, _id_thr, _conf, _margin, cycle_ms, timestamp, _img = row
            stamp = str(timestamp)[0:19]
            self.dashboard_recent_box.insert(
                "end", f"{int(rid):<4}  {str(status):<6}  {str(product)[:22]:<22}  {str(defect)[:21]:<21}  {float(cycle_ms or 0):>6.0f}  {stamp}\n"
            )
        self.dashboard_recent_box.configure(state="disabled")

        if HAVE_MPL and self.canvas is not None and self.ax is not None:
            self.ax.clear()
            if rows:
                x = np.arange(len(rows))
                scores = [float(row[4]) for row in rows]
                self.ax.plot(x, scores, marker="o", linewidth=1.5)
                self.ax.set_ylabel("Anomaly score")
                self.ax.set_xlabel("Recent inspection sequence")
                self.ax.set_title("Recent anomaly scores")
                self.ax.grid(True, alpha=0.25)
                self.ax.tick_params(axis="x", labelsize=8)
            else:
                self.ax.set_title("No inspection records yet")
            self.figure.tight_layout()
            self.canvas.draw_idle()

        self.after(5000, self._refresh_dashboard)

