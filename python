# Camera-side drawing: fixed yellow ROI + explicit perpendicular crosshair + bbox.

def _v13_draw_roi(self: InspectionApp, frame: np.ndarray, title: str) -> np.ndarray:
    out = frame.copy()
    x, y, w, h = self.roi
    hh, ww = out.shape[:2]
    x = max(0, min(x, max(0, ww - 1)))
    y = max(0, min(y, max(0, hh - 1)))
    w = max(10, min(w, max(10, ww - x)))
    h = max(10, min(h, max(10, hh - y)))
    cv2.rectangle(out, (x, y), (x + w, y + h), (0, 255, 255), 2)

    cx = x + w // 2
    cy = y + h // 2
    arm = max(24, min(w, h) // 5)
    cv2.line(out, (cx - arm, cy), (cx + arm, cy), (255, 255, 255), 2, cv2.LINE_AA)
    cv2.line(out, (cx, cy - arm), (cx, cy + arm), (255, 255, 255), 2, cv2.LINE_AA)
    cv2.circle(out, (cx, cy), 7, (0, 255, 255), -1, cv2.LINE_AA)
    cv2.circle(out, (cx, cy), 12, (255, 255, 255), 2, cv2.LINE_AA)
    cv2.putText(out, "CENTER", (cx + 16, cy - 12), cv2.FONT_HERSHEY_SIMPLEX,
                0.50, (255, 255, 255), 2, cv2.LINE_AA)

    cv2.putText(out, title, (max(10, x), max(25, y - 8)),
                cv2.FONT_HERSHEY_SIMPLEX, 0.60, (0, 255, 255), 2, cv2.LINE_AA)
    status = "CALIBRATING — HOLD STILL" if self.position_calibration_active else self.position_message
    cv2.putText(out, status, (max(10, x + 8), max(48, y + 26)),
                cv2.FONT_HERSHEY_SIMPLEX, 0.54, (0, 255, 255), 2, cv2.LINE_AA)
    if self.position_bbox is not None:
        bx, by, bw, bh = self.position_bbox
        color = (0, 255, 0) if self.position_ready else (0, 165, 255)
        cv2.rectangle(out, (x + bx, y + by), (x + bx + bw, y + by + bh), color, 2)
    return out


