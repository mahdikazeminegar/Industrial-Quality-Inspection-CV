class InspectionDB:
    def __init__(self, db_path: Path):
        self.lock = threading.RLock()
        self.conn = sqlite3.connect(str(db_path), check_same_thread=False)
        self._create_or_migrate()

    def _create_or_migrate(self) -> None:
        with self.lock:
            cur = self.conn.cursor()
            cur.execute(
                """
                CREATE TABLE IF NOT EXISTS logs (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    part_name TEXT,
                    status TEXT,
                    defect_type TEXT,
                    score REAL,
                    threshold REAL,
                    identity_distance REAL,
                    identity_threshold REAL,
                    defect_confidence REAL,
                    defect_margin REAL,
                    cycle_time_ms REAL DEFAULT 0,
                    timestamp TEXT,
                    image_path TEXT
                )
                """
            )
            self.conn.commit()
            cur.execute("PRAGMA table_info(logs)")
            existing = {row[1] for row in cur.fetchall()}
            required = {
                "part_name": "TEXT",
                "status": "TEXT",
                "defect_type": "TEXT",
                "score": "REAL",
                "threshold": "REAL",
                "identity_distance": "REAL",
                "identity_threshold": "REAL",
                "defect_confidence": "REAL",
                "defect_margin": "REAL",
                "cycle_time_ms": "REAL DEFAULT 0",
                "timestamp": "TEXT",
                "image_path": "TEXT",
            }
            for column, dtype in required.items():
                if column not in existing:
                    cur.execute(f"ALTER TABLE logs ADD COLUMN {column} {dtype}")
            self.conn.commit()

    def add(
        self,
        part_name: str,
        status: str,
        defect_type: str,
        score: float,
        threshold: float,
        identity_distance: float,
        identity_threshold: float,
        defect_confidence: float,
        defect_margin: float,
        image_path: str,
        cycle_time_ms: float = 0.0,
    ) -> None:
        with self.lock:
            self.conn.execute(
                """
                INSERT INTO logs(
                    part_name, status, defect_type, score, threshold,
                    identity_distance, identity_threshold, defect_confidence, defect_margin, cycle_time_ms, timestamp, image_path
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    part_name,
                    status,
                    defect_type,
                    float(score),
                    float(threshold),
                    float(identity_distance),
                    float(identity_threshold),
                    float(defect_confidence),
                    float(defect_margin),
                    float(cycle_time_ms),
                    now_text(),
                    image_path,
                ),
            )
            self.conn.commit()

    def counts(self) -> tuple[int, int, int]:
        with self.lock:
            row = self.conn.execute(
                "SELECT COUNT(*), "
                "SUM(CASE WHEN status='PASS' THEN 1 ELSE 0 END), "
                "SUM(CASE WHEN status='FAIL' THEN 1 ELSE 0 END) FROM logs"
            ).fetchone()
        return int(row[0] or 0), int(row[1] or 0), int(row[2] or 0)

    def recent(self, limit: int = 50):
        with self.lock:
            return self.conn.execute(
                "SELECT id, part_name, status, defect_type, score, threshold, "
                "identity_distance, identity_threshold, defect_confidence, defect_margin, cycle_time_ms, timestamp, image_path "
                "FROM logs ORDER BY id DESC LIMIT ?",
                (int(limit),),
            ).fetchall()

    def update_latest_cycle_time(self, cycle_time_ms: float) -> None:
        with self.lock:
            self.conn.execute(
                "UPDATE logs SET cycle_time_ms=? WHERE id=(SELECT MAX(id) FROM logs)",
                (float(max(0.0, cycle_time_ms)),),
            )
            self.conn.commit()

    def analytics(self) -> dict:
        with self.lock:
            total, passed, failed = self.conn.execute(
                "SELECT COUNT(*), "
                "SUM(CASE WHEN status='PASS' THEN 1 ELSE 0 END), "
                "SUM(CASE WHEN status='FAIL' THEN 1 ELSE 0 END) FROM logs"
            ).fetchone()
            today_total, today_pass, today_fail = self.conn.execute(
                "SELECT COUNT(*), "
                "SUM(CASE WHEN status='PASS' THEN 1 ELSE 0 END), "
                "SUM(CASE WHEN status='FAIL' THEN 1 ELSE 0 END) "
                "FROM logs WHERE date(timestamp)=date('now','localtime')"
            ).fetchone()
            avg_cycle, min_cycle, max_cycle = self.conn.execute(
                "SELECT AVG(cycle_time_ms), MIN(cycle_time_ms), MAX(cycle_time_ms) "
                "FROM logs WHERE cycle_time_ms > 0"
            ).fetchone()
            defects = self.conn.execute(
                "SELECT COALESCE(defect_type,'UNKNOWN'), COUNT(*) FROM logs "
                "WHERE status='FAIL' GROUP BY defect_type ORDER BY COUNT(*) DESC, defect_type LIMIT 12"
            ).fetchall()
            products = self.conn.execute(
                "SELECT COALESCE(part_name,'UNKNOWN'), COUNT(*) FROM logs "
                "GROUP BY part_name ORDER BY COUNT(*) DESC LIMIT 12"
            ).fetchall()
        total = int(total or 0); passed = int(passed or 0); failed = int(failed or 0)
        today_total = int(today_total or 0); today_pass = int(today_pass or 0); today_fail = int(today_fail or 0)
        return {
            "total": total, "passed": passed, "failed": failed,
            "pass_rate": (100.0 * passed / total) if total else 0.0,
            "today_total": today_total, "today_pass": today_pass, "today_fail": today_fail,
            "avg_cycle_ms": float(avg_cycle or 0.0),
            "min_cycle_ms": float(min_cycle or 0.0),
            "max_cycle_ms": float(max_cycle or 0.0),
            "defects": [(str(a), int(b)) for a, b in defects],
            "products": [(str(a), int(b)) for a, b in products],
        }

    def export_csv(self, path: Path) -> None:
        headers = [
            "id", "part_name", "status", "defect_type", "score", "threshold",
            "identity_distance", "identity_threshold", "defect_confidence", "defect_margin", "cycle_time_ms", "timestamp", "image_path",
        ]
        rows = self.recent(limit=1_000_000)
        with path.open("w", newline="", encoding="utf-8-sig") as handle:
            writer = csv.writer(handle)
            writer.writerow(headers)
            writer.writerows(rows)

    def export_xlsx(self, path: Path) -> None:
        try:
            from openpyxl import Workbook
            from openpyxl.styles import Font
        except ImportError as exc:
            raise RuntimeError("openpyxl is required for Excel export. Install: pip install openpyxl") from exc

        headers = [
            "id", "part_name", "status", "defect_type", "score", "threshold",
            "identity_distance", "identity_threshold", "defect_confidence", "defect_margin", "cycle_time_ms", "timestamp", "image_path",
        ]
        rows = self.recent(limit=1_000_000)
        wb = Workbook()
        ws = wb.active
        ws.title = "Inspection Logs"
        ws.append(headers)
        for row in rows:
            ws.append(list(row))
        for cell in ws[1]:
            cell.font = Font(bold=True)
        widths = [8, 24, 12, 28, 14, 14, 20, 22, 18, 16, 16, 22, 65]
        for i, width in enumerate(widths, 1):
            ws.column_dimensions[chr(64 + i)].width = width
        wb.save(path)

    def close(self) -> None:
        with self.lock:
            try:
                self.conn.close()
            except Exception:
                pass


# -----------------------------------------------------------------------------
# Frozen ResNet18 feature extractor
# -----------------------------------------------------------------------------
class ResNet18FeatureExtractor:
    """Shared backbone for both product identity and anomaly features."""

    def __init__(self, device: Optional[str] = None):
        chosen = device or ("cuda" if torch.cuda.is_available() else "cpu")
        self.device = torch.device(chosen)
        self.weights = ResNet18_Weights.DEFAULT
        self.backbone = resnet18(weights=self.weights, progress=True).to(self.device).eval()
        self.transform = transforms.Compose([
            # Full ROI -> fixed tensor; no center crop that could throw away edges.
            transforms.Resize((INPUT_SIZE, INPUT_SIZE), antialias=True),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
        ])
        for parameter in self.backbone.parameters():
            parameter.requires_grad_(False)

    def _tensor(self, image: np.ndarray) -> torch.Tensor:
        if image is None or image.size == 0:
            raise ValueError("Empty image received by feature extractor.")
        rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
        return self.transform(Image.fromarray(rgb))

    @torch.inference_mode()
    def _forward_stages(self, batch: torch.Tensor):
        x = self.backbone.conv1(batch)
        x = self.backbone.bn1(x)
        x = self.backbone.relu(x)
        x = self.backbone.maxpool(x)
        x = self.backbone.layer1(x)
        f2 = self.backbone.layer2(x)
        f3 = self.backbone.layer3(f2)
        f4 = self.backbone.layer4(f3)
        return f2, f3, f4

    @torch.inference_mode()
    def identity_embeddings(self, images: list[np.ndarray], batch_size: int = 8, already_canonical: bool = False) -> np.ndarray:
        """Global layer3+layer4 identity embedding after object canonicalization.

        V9 removes V8's 2x2 spatial descriptor because the previous representation
        was unnecessarily sensitive to small translations/scales inside the ROI.
        """
        canonical_images = list(images) if already_canonical else [canonicalize_object(img)[0] for img in images]
        outputs: list[np.ndarray] = []
        for start in range(0, len(canonical_images), batch_size):
            batch = torch.stack(
                [self._tensor(img) for img in canonical_images[start:start + batch_size]], dim=0
            ).to(self.device)
            _, f3, f4 = self._forward_stages(batch)
            p3g = F.adaptive_avg_pool2d(f3, 1).flatten(1)
            p4g = F.adaptive_avg_pool2d(f4, 1).flatten(1)
            emb = torch.cat([p3g, p4g], dim=1)
            emb = F.normalize(emb, p=2, dim=1)
            outputs.append(emb.cpu().numpy().astype(np.float32))
        if not outputs:
            raise ValueError("No images supplied for identity embedding extraction.")
        return np.vstack(outputs)

    @torch.inference_mode()
    def defect_embeddings(self, images: list[np.ndarray], batch_size: int = 8) -> np.ndarray:
        """Feature vector for user-defined defect classification.

        Uses global average/max descriptors from ResNet stages 2–4 after the
        same object canonicalization used by V9 identity/anomaly processing.
        This keeps the defect model sensitive to both global shape and local
        appearance while remaining lightweight enough for CPU inference.
        """
        canonical_images = [canonicalize_object(img)[0] for img in images]
        outputs: list[np.ndarray] = []
        for start in range(0, len(canonical_images), batch_size):
            batch = torch.stack(
                [self._tensor(img) for img in canonical_images[start:start + batch_size]], dim=0
            ).to(self.device)
            f2, f3, f4 = self._forward_stages(batch)
            features = []
            for feat in (f2, f3, f4):
                features.append(F.adaptive_avg_pool2d(feat, 1).flatten(1))
                features.append(F.adaptive_max_pool2d(feat, 1).flatten(1))
            emb = torch.cat(features, dim=1)
            emb = F.normalize(emb, p=2, dim=1)
            outputs.append(emb.cpu().numpy().astype(np.float32))
        if not outputs:
            raise ValueError("No images supplied for defect embedding extraction.")
        return np.vstack(outputs)

    @torch.inference_mode()
    def defect_embeddings_for_canonical(self, canonical_images: list[np.ndarray], batch_size: int = 8) -> np.ndarray:
        outputs: list[np.ndarray] = []
        for start in range(0, len(canonical_images), batch_size):
            batch = torch.stack(
                [self._tensor(img) for img in canonical_images[start:start + batch_size]], dim=0
            ).to(self.device)
            f2, f3, f4 = self._forward_stages(batch)
            features = []
            for feat in (f2, f3, f4):
                features.append(F.adaptive_avg_pool2d(feat, 1).flatten(1))
                features.append(F.adaptive_max_pool2d(feat, 1).flatten(1))
            emb = F.normalize(torch.cat(features, dim=1), p=2, dim=1)
            outputs.append(emb.cpu().numpy().astype(np.float32))
        if not outputs:
            raise ValueError("No canonical images supplied for defect embedding extraction.")
        return np.vstack(outputs)

    @torch.inference_mode()
    def patch_embedding_lists(
        self,
        images: list[np.ndarray],
        batch_size: int = 8,
        already_canonical: bool = False,
    ) -> tuple[list[np.ndarray], tuple[int, int]]:
        results: list[np.ndarray] = []
        grid: Optional[tuple[int, int]] = None
        canonical_images = list(images) if already_canonical else [canonicalize_object(img)[0] for img in images]
        for start in range(0, len(canonical_images), batch_size):
            batch = torch.stack(
                [self._tensor(img) for img in canonical_images[start:start + batch_size]], dim=0
            ).to(self.device)
            f2, f3, _ = self._forward_stages(batch)
            f3 = F.interpolate(f3, size=f2.shape[-2:], mode="bilinear", align_corners=False)
            f2 = F.avg_pool2d(f2, kernel_size=3, stride=1, padding=1)
            f3 = F.avg_pool2d(f3, kernel_size=3, stride=1, padding=1)
            f2 = F.normalize(f2, p=2, dim=1)
            f3 = F.normalize(f3, p=2, dim=1)
            feature = F.normalize(torch.cat([f2, f3], dim=1), p=2, dim=1)
            grid = (int(feature.shape[-2]), int(feature.shape[-1]))
            patches = feature.permute(0, 2, 3, 1).contiguous().view(feature.shape[0], -1, feature.shape[1])
            results.extend([sample.cpu().numpy().astype(np.float32) for sample in patches])
        if grid is None or not results:
            raise ValueError("No images supplied for patch feature extraction.")
        return results, grid


# -----------------------------------------------------------------------------
# PatchCore-style normal-only anomaly detector
# -----------------------------------------------------------------------------
@dataclass
class DetectorInfo:
    num_good_images: int
    memory_bank_size: int
    raw_patch_count: int
    threshold: float
    created_at: str


class PatchCoreDetector:
    FORMAT_VERSION = MODEL_FORMAT_VERSION

    def __init__(self, extractor: ResNet18FeatureExtractor):
        self.extractor = extractor
        self.memory_bank: Optional[np.ndarray] = None
        self.knn: Optional[NearestNeighbors] = None
        self.threshold = math.inf
        self.calibration_low = 0.0
        self.calibration_high = 1.0
        self.info: Optional[DetectorInfo] = None

    @staticmethod
    def _greedy_coreset(features: np.ndarray, target_size: int, seed: int = 42) -> np.ndarray:
        n, d = features.shape
        if target_size >= n:
            return features.copy()
        target_size = max(1, min(int(target_size), n))
        rng = np.random.default_rng(seed)
        if n > CORESET_MAX_CANDIDATES:
            candidate_idx = rng.choice(n, size=CORESET_MAX_CANDIDATES, replace=False)
            candidates = features[candidate_idx]
        else:
            candidates = features
        projection_dim = min(64, d)
        projection = rng.standard_normal((d, projection_dim), dtype=np.float32)
        projected = candidates @ projection
        projected = projected / np.maximum(np.linalg.norm(projected, axis=1, keepdims=True), 1e-8)

        selected = np.empty(target_size, dtype=np.int32)
        first = int(rng.integers(0, len(projected)))
        selected[0] = first
        min_dist = np.sum((projected - projected[first]) ** 2, axis=1)
        min_dist[first] = -1.0
        for idx in range(1, target_size):
            chosen = int(np.argmax(min_dist))
            selected[idx] = chosen
            d2 = np.sum((projected - projected[chosen]) ** 2, axis=1)
            min_dist = np.minimum(min_dist, d2)
            min_dist[chosen] = -1.0
        return candidates[selected]

    @staticmethod
    def _make_knn(memory: np.ndarray) -> NearestNeighbors:
        model = NearestNeighbors(n_neighbors=1, algorithm="brute", metric="euclidean", n_jobs=-1)
        model.fit(memory)
        return model

    @staticmethod
    def _image_score(distances: np.ndarray) -> float:
        vals = np.asarray(distances, dtype=np.float32).reshape(-1)
        vals = vals[np.isfinite(vals)]
        if vals.size == 0:
            return 0.0
        count = max(5, int(math.ceil(vals.size * PATCH_TOP_FRACTION)))
        count = min(count, vals.size)
        kth = vals.size - count
        top = np.partition(vals, kth)[kth:]
        return float(np.mean(top))

    @classmethod
    def _score_features(
        cls,
        patch_features: np.ndarray,
        knn: NearestNeighbors,
    ) -> tuple[float, np.ndarray]:
        distances = knn.kneighbors(patch_features, n_neighbors=1, return_distance=True)[0][:, 0]
        distances = distances.astype(np.float32)
        return cls._image_score(distances), distances

    def fit(self, images: list[np.ndarray], progress: Optional[Callable[[str], None]] = None) -> DetectorInfo:
        if len(images) < TRAIN_MINIMUM:
            raise ValueError(
                f"A product needs at least {TRAIN_MINIMUM} GOOD images. Received {len(images)}."
            )

        def report(message: str) -> None:
            if progress:
                progress(message)

        report(f"Extracting patch features from {len(images)} GOOD images...")
        per_image, grid = self.extractor.patch_embedding_lists(images)
        raw_patch_count = int(sum(len(x) for x in per_image))

        indices = np.arange(len(images))
        rng = np.random.default_rng(42)
        rng.shuffle(indices)
        fold_count = 3 if len(images) >= 24 else 2
        folds = np.array_split(indices, fold_count)

        validation_scores: list[float] = []
        validation_distances: list[np.ndarray] = []
        for fold_no, val_idx in enumerate(folds, 1):
            train_idx = np.concatenate(
                [fold for j, fold in enumerate(folds) if j != fold_no - 1]
            )
            train_features = np.vstack([per_image[i] for i in train_idx])
            target = max(128, int(len(train_features) * CORESET_RATIO))
            target = min(target, len(train_features), CORESET_MAX_MEMORY)
            memory = self._greedy_coreset(train_features, target, seed=100 + fold_no)
            knn = self._make_knn(memory)
            for i in val_idx:
                score, distances = self._score_features(per_image[i], knn)
                validation_scores.append(score)
                validation_distances.append(distances)
            report(f"Anomaly calibration fold {fold_no}/{fold_count} complete.")

        score_array = np.asarray(validation_scores, dtype=np.float32)
        self.threshold = robust_upper(score_array, ANOMALY_THRESHOLD_MARGIN, floor=1e-6)

        all_distances = np.concatenate(validation_distances) if validation_distances else np.array([0.0])
        self.calibration_low = float(np.percentile(all_distances, 50.0))
        self.calibration_high = float(np.percentile(all_distances, 99.5))
        if self.calibration_high <= self.calibration_low:
            self.calibration_high = self.calibration_low + 1e-6

        all_features = np.vstack(per_image)
        target = max(128, int(len(all_features) * CORESET_RATIO))
        target = min(target, len(all_features), CORESET_MAX_MEMORY)
        self.memory_bank = self._greedy_coreset(all_features, target, seed=42)
        self.knn = self._make_knn(self.memory_bank)
        self.info = DetectorInfo(
            num_good_images=len(images),
            memory_bank_size=len(self.memory_bank),
            raw_patch_count=raw_patch_count,
            threshold=float(self.threshold),
            created_at=now_text(),
        )
        report(
            f"Patch model ready: {grid[0]}x{grid[1]} patches/image | "
            f"threshold={self.threshold:.5f}"
        )
        return self.info

    def predict(self, roi_bgr: np.ndarray) -> tuple[bool, float, np.ndarray, float]:
        if self.knn is None:
            raise RuntimeError("Patch model is not loaded.")
        canonical, bbox = canonicalize_object(roi_bgr)
        per_image, grid = self.extractor.patch_embedding_lists([canonical], batch_size=1, already_canonical=True)
        score, distances = self._score_features(per_image[0], self.knn)
        is_anomaly = score > self.threshold
        patch_map = distances.reshape(grid)

        denominator = max(self.calibration_high - self.calibration_low, 1e-6)
        heat = np.clip((patch_map - self.calibration_low) / denominator, 0.0, 1.0)
        heat = cv2.resize(heat, (INPUT_SIZE, INPUT_SIZE), interpolation=cv2.INTER_CUBIC)
        blur = HEATMAP_BLUR if HEATMAP_BLUR % 2 else HEATMAP_BLUR + 1
        heat = cv2.GaussianBlur(heat, (blur, blur), 0)

        full_heat = np.zeros((roi_bgr.shape[0], roi_bgr.shape[1]), dtype=np.float32)
        x, y, bw, bh = bbox
        if bw > 0 and bh > 0:
            restored = cv2.resize(heat, (bw, bh), interpolation=cv2.INTER_CUBIC)
            full_heat[y:y + bh, x:x + bw] = restored
        return bool(is_anomaly), float(score), full_heat.astype(np.float32), float(self.threshold)

    def export(self) -> dict:
        if self.memory_bank is None or self.info is None:
            raise RuntimeError("Patch detector is not fitted.")
        return {
            "memory_bank": self.memory_bank,
            "threshold": np.array([self.threshold], dtype=np.float32),
            "calibration_low": np.array([self.calibration_low], dtype=np.float32),
            "calibration_high": np.array([self.calibration_high], dtype=np.float32),
            "metadata": np.array(json.dumps({
                "format_version": self.FORMAT_VERSION,
                "num_good_images": self.info.num_good_images,
                "memory_bank_size": self.info.memory_bank_size,
                "raw_patch_count": self.info.raw_patch_count,
                "created_at": self.info.created_at,
            }), dtype=str),
        }

    def import_saved(self, data: dict) -> None:
        self.memory_bank = np.asarray(data["memory_bank"], dtype=np.float32)
        self.threshold = float(np.asarray(data["threshold"]).reshape(-1)[0])
        self.calibration_low = float(np.asarray(data["calibration_low"]).reshape(-1)[0])
        self.calibration_high = float(np.asarray(data["calibration_high"]).reshape(-1)[0])
        metadata = json.loads(str(data["metadata"]))
        saved_version = int(metadata.get("format_version", -1))
        if saved_version != self.FORMAT_VERSION:
            raise RuntimeError(f"Saved patch model format {saved_version} is incompatible with V10.")
        self.info = DetectorInfo(
            num_good_images=int(metadata.get("num_good_images", 0)),
            memory_bank_size=int(metadata.get("memory_bank_size", len(self.memory_bank))),
            raw_patch_count=int(metadata.get("raw_patch_count", 0)),
            threshold=self.threshold,
            created_at=str(metadata.get("created_at", "")),
        )
        self.knn = self._make_knn(self.memory_bank)


# -----------------------------------------------------------------------------
# Supervised per-product defect classifier
# -----------------------------------------------------------------------------
class ProductDefectClassifier:
    """A small supervised classifier trained separately for each product.

    Expected classes are GOOD plus one or more operator-defined defect names.
    The classifier is deliberately secondary to the GOOD-only anomaly detector:
    it names known defects, while PatchCore-style detection can still flag
    previously unseen anomalies.
    """

    FORMAT_VERSION = MODEL_FORMAT_VERSION

    def __init__(self, extractor: ResNet18FeatureExtractor):
        self.extractor = extractor
        self.classifier: Optional[LogisticRegression] = None
        self.probability_threshold = DEFECT_MIN_PROB
        self.margin_threshold = DEFECT_MIN_MARGIN
        self.sample_counts: dict[str, int] = {}

    @property
    def classes(self) -> list[str]:
        if self.classifier is None:
            return []
        return [str(x) for x in self.classifier.classes_]

    def fit(
        self,
        class_datasets: dict[str, list[np.ndarray]],
        progress: Optional[Callable[[str], None]] = None,
    ) -> None:
        cleaned = {str(k).strip(): v for k, v in class_datasets.items() if str(k).strip() and v}
        if "GOOD" not in cleaned:
            raise ValueError("Defect training requires a GOOD class.")
        defect_classes = [k for k in cleaned if k != "GOOD"]
        if not defect_classes:
            self.classifier = None
            self.sample_counts = {"GOOD": len(cleaned["GOOD"])}
            if progress:
                progress("No user-defined defects exist yet; GOOD-only anomaly detection remains active.")
            return
        for label, images in cleaned.items():
            if len(images) < DEFECT_MINIMUM_PER_CLASS:
                raise ValueError(
                    f"Defect class '{label}' needs at least {DEFECT_MINIMUM_PER_CLASS} images; "
                    f"received {len(images)}."
                )

        if progress:
            progress(f"Extracting supervised defect features for {len(cleaned)} classes...")
        X_parts = []
        y_parts = []
        self.sample_counts = {}
        for label in sorted(cleaned.keys()):
            images = cleaned[label]
            feats = self.extractor.defect_embeddings(images)
            X_parts.append(feats)
            y_parts.extend([label] * len(images))
            self.sample_counts[label] = len(images)

        X = np.vstack(X_parts).astype(np.float32)
        y = np.asarray(y_parts, dtype=str)
        clf = LogisticRegression(
            C=DEFECT_CLASSIFIER_C,
            max_iter=3000,
            class_weight="balanced",
            solver="lbfgs",
            random_state=42,
        )
        clf.fit(X, y)

        # Cross-validation estimates how confidently the classifier recognizes
        # its own labeled examples. These are used only as conservative gates.
        counts = {label: int(np.sum(y == label)) for label in np.unique(y)}
        min_count = min(counts.values())
        prob_threshold = DEFECT_MIN_PROB
        margin_threshold = DEFECT_MIN_MARGIN
        if min_count >= 3 and len(np.unique(y)) >= 2:
            n_splits = min(5, min_count)
            cv = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)
            try:
                probs = cross_val_predict(clf, X, y, cv=cv, method="predict_proba", n_jobs=1)
                labels = [str(x) for x in clf.classes_]
                idx_map = {label: i for i, label in enumerate(labels)}
                correct_prob = np.asarray([probs[i, idx_map[str(y[i])]] for i in range(len(y))])
                ordered = np.sort(probs, axis=1)
                margins = ordered[:, -1] - ordered[:, -2] if probs.shape[1] >= 2 else np.ones(len(y))
                prob_threshold = max(DEFECT_MIN_PROB, float(np.percentile(correct_prob, 5.0)) - 0.03)
                margin_threshold = max(DEFECT_MIN_MARGIN, float(np.percentile(margins, 5.0)) * 0.45)
            except Exception:
                pass

        self.classifier = clf
        self.probability_threshold = prob_threshold
        self.margin_threshold = margin_threshold
        if progress:
            progress(
                f"Defect classifier ready: {', '.join(self.classes)} | "
                f"probability≥{self.probability_threshold:.3f} | margin≥{self.margin_threshold:.3f}"
            )

    def predict(self, image: np.ndarray) -> tuple[str, float, float]:
        if self.classifier is None:
            return "NO_DEFECT_MODEL", 0.0, 0.0
        feature = self.extractor.defect_embeddings([image])[0]
        probs = self.classifier.predict_proba(feature.reshape(1, -1))[0]
        order = np.argsort(probs)[::-1]
        best_i = int(order[0])
        label = str(self.classifier.classes_[best_i])
        prob = float(probs[best_i])
        margin = float(probs[order[0]] - probs[order[1]]) if len(order) >= 2 else 1.0
        if prob < self.probability_threshold or margin < self.margin_threshold:
            return "UNKNOWN_DEFECT", prob, margin
        return label, prob, margin

    def export(self) -> dict:
        if self.classifier is None:
            return {"present": np.array([0], dtype=np.int32)}
        return {
            "present": np.array([1], dtype=np.int32),
            "coef": np.asarray(self.classifier.coef_, dtype=np.float32),
            "intercept": np.asarray(self.classifier.intercept_, dtype=np.float32),
            "classes": np.asarray(self.classifier.classes_, dtype=str),
            "n_features": np.array([self.classifier.n_features_in_], dtype=np.int32),
            "n_iter": np.asarray(getattr(self.classifier, "n_iter_", [0]), dtype=np.int32),
            "probability_threshold": np.array([self.probability_threshold], dtype=np.float32),
            "margin_threshold": np.array([self.margin_threshold], dtype=np.float32),
            "sample_counts": np.array(json.dumps(self.sample_counts), dtype=str),
        }

    def import_saved(self, data: dict) -> None:
        present = int(np.asarray(data["present"]).reshape(-1)[0]) if "present" in data else 0
        self.classifier = None
        self.sample_counts = {}
        if not present:
            return
        clf = LogisticRegression(
            C=DEFECT_CLASSIFIER_C,
            max_iter=3000,
            class_weight="balanced",
            solver="lbfgs",
            random_state=42,
        )
        clf.classes_ = np.asarray(data["classes"], dtype=str)
        clf.coef_ = np.asarray(data["coef"], dtype=np.float64)
        clf.intercept_ = np.asarray(data["intercept"], dtype=np.float64)
        clf.n_features_in_ = int(np.asarray(data["n_features"]).reshape(-1)[0])
        clf.n_iter_ = np.asarray(data.get("n_iter", np.array([0])), dtype=np.int32)
        self.probability_threshold = float(np.asarray(data["probability_threshold"]).reshape(-1)[0])
        self.margin_threshold = float(np.asarray(data["margin_threshold"]).reshape(-1)[0])
        try:
            self.sample_counts = json.loads(str(data["sample_counts"]))
        except Exception:
            self.sample_counts = {}
        self.classifier = clf


# -----------------------------------------------------------------------------
# Labeled product model
# -----------------------------------------------------------------------------
@dataclass
class ProductModel:
    name: str
    directory_name: str
    identity_bank: np.ndarray
    identity_centroid: np.ndarray
    identity_nn_threshold: float
    identity_centroid_threshold: float
    detector: PatchCoreDetector
    sample_count: int
    defect_classifier: Optional[ProductDefectClassifier] = None


class LabeledProductModel:
    """
    V10 multi-product model set.

    Each product owns a GOOD dataset, a GOOD-only anomaly detector and, when
    supplied by the operator, a supervised defect classifier whose classes are
    GOOD + user-defined defect names such as NO_CAP, SCRATCH or DENT.
    """

    def __init__(self, extractor: ResNet18FeatureExtractor):
        self.extractor = extractor
        self.products: list[ProductModel] = []
        self.created_at = ""
        self.identity_classifier: Optional[LogisticRegression] = None
        self.classifier_prob_threshold = CLASSIFIER_MIN_PROB
        self.classifier_margin_threshold = CLASSIFIER_MIN_MARGIN

    @staticmethod
    def _topk_mean(values: np.ndarray, k: int) -> float:
        values = np.sort(np.asarray(values, dtype=np.float32).reshape(-1))
        if values.size == 0:
            return math.inf
        k = min(max(1, k), values.size)
        return float(np.mean(values[:k]))

    @classmethod
    def _calibrate_identity_thresholds(cls, embeddings: np.ndarray, augmented_embeddings: Optional[np.ndarray] = None) -> tuple[float, float]:
        embeddings = np.asarray(embeddings, dtype=np.float32)
        n = len(embeddings)
        if n < 2:
            return IDENTITY_FALLBACK_THRESHOLD, IDENTITY_FALLBACK_THRESHOLD
        normalized = embeddings / np.maximum(np.linalg.norm(embeddings, axis=1, keepdims=True), 1e-8)
        similarity = normalized @ normalized.T
        np.fill_diagonal(similarity, -np.inf)
        loo_min_distance = 1.0 - np.max(similarity, axis=1)
        centroid = normalized.mean(axis=0)
        centroid /= max(float(np.linalg.norm(centroid)), 1e-8)
        centroid_distances = 1.0 - normalized @ centroid
        nn_values = list(loo_min_distance.astype(np.float32))
        centroid_values = list(centroid_distances.astype(np.float32))
        if augmented_embeddings is not None and len(augmented_embeddings) >= n:
            aug = np.asarray(augmented_embeddings, dtype=np.float32)
            aug = aug / np.maximum(np.linalg.norm(aug, axis=1, keepdims=True), 1e-8)
            for i in range(n):
                sims = aug[i] @ normalized.T
                if n > 1:
                    sims[i] = -np.inf
                nn_values.append(float(1.0 - np.max(sims)))
                centroid_values.append(float(1.0 - aug[i] @ centroid))
        nn_threshold = robust_upper(np.asarray(nn_values), 1.03, floor=0.02)
        centroid_threshold = robust_upper(np.asarray(centroid_values), 1.03, floor=0.02)
        return float(nn_threshold), float(centroid_threshold)

    @staticmethod
    def _product_score(query: np.ndarray, product: ProductModel, classifier_probability: Optional[float] = None) -> tuple[float, float, float]:
        distances = cosine_distance(query, product.identity_bank)
        nearest_mean = LabeledProductModel._topk_mean(distances, IDENTITY_TOP_K)
        centroid_distance = float(cosine_distance(query, product.identity_centroid)[0])
        nn_norm = nearest_mean / max(product.identity_nn_threshold, 1e-6)
        centroid_norm = centroid_distance / max(product.identity_centroid_threshold, 1e-6)
        if classifier_probability is None:
            combined = IDENTITY_WEIGHT_NEAREST * nn_norm + IDENTITY_WEIGHT_CENTROID * centroid_norm
        else:
            combined = (
                IDENTITY_WEIGHT_NEAREST * nn_norm
                + IDENTITY_WEIGHT_CENTROID * centroid_norm
                + IDENTITY_WEIGHT_CLASSIFIER * (1.0 - float(classifier_probability))
            )
        return float(combined), float(nearest_mean), centroid_distance

    def _defect_datasets_for_product(self, directory_name: str) -> dict[str, list[np.ndarray]]:
        product_dir = DATASET_ROOT / directory_name
        result: dict[str, list[np.ndarray]] = {}
        good_dir = product_dir / "good"
        good_paths = sorted([p for p in good_dir.rglob("*") if p.is_file() and p.suffix.lower() in VALID_IMAGE_EXTENSIONS]) if good_dir.exists() else []
        good_images = read_images(good_paths)
        if good_images:
            result["GOOD"] = good_images
        defect_root = product_dir / "defects"
        if defect_root.exists():
            for defect_dir in sorted([p for p in defect_root.iterdir() if p.is_dir()], key=lambda p: p.name.lower()):
                files = sorted([p for p in defect_dir.rglob("*") if p.is_file() and p.suffix.lower() in VALID_IMAGE_EXTENSIONS], key=lambda p: str(p).lower())
                images = read_images(files)
                if images:
                    result[defect_dir.name] = images
        return result

    def fit_product(self, name: str, directory_name: str, images: list[np.ndarray], defect_datasets: Optional[dict[str, list[np.ndarray]]] = None, progress: Optional[Callable[[str], None]] = None) -> ProductModel:
        if len(images) < TRAIN_MINIMUM:
            raise ValueError(f"Product '{name}' needs at least {TRAIN_MINIMUM} GOOD images. Received {len(images)}.")
        def report(message: str) -> None:
            if progress:
                progress(message)
        report(f"{name}: extracting stabilized ResNet-18 identity embeddings from {len(images)} GOOD images...")
        identity_bank = self.extractor.identity_embeddings(images)
        identity_bank = identity_bank / np.maximum(np.linalg.norm(identity_bank, axis=1, keepdims=True), 1e-8)
        centroid = identity_bank.mean(axis=0)
        centroid /= max(float(np.linalg.norm(centroid)), 1e-8)
        augmented_images = identity_augmentations_for_images(images)
        augmented_embeddings = self.extractor.identity_embeddings(augmented_images, already_canonical=True)
        augmented_embeddings = augmented_embeddings / np.maximum(np.linalg.norm(augmented_embeddings, axis=1, keepdims=True), 1e-8)
        nn_thr, centroid_thr = self._calibrate_identity_thresholds(identity_bank, augmented_embeddings)
        report(f"{name}: identity gates | nearest≤{nn_thr:.4f} | centroid≤{centroid_thr:.4f}")
        detector = PatchCoreDetector(self.extractor)
        detector.fit(images, progress=lambda msg: report(f"{name}: {msg}"))
        defect_classifier: Optional[ProductDefectClassifier] = None
        if defect_datasets is not None and any(k != "GOOD" for k in defect_datasets):
            defect_classifier = ProductDefectClassifier(self.extractor)
            defect_classifier.fit(defect_datasets, progress=lambda msg: report(f"{name}: {msg}"))
        else:
            report(f"{name}: no supervised defect classes; GOOD-only anomaly inspection remains active.")
        return ProductModel(
            name=name,
            directory_name=directory_name,
            identity_bank=identity_bank.astype(np.float32),
            identity_centroid=centroid.astype(np.float32),
            identity_nn_threshold=float(nn_thr),
            identity_centroid_threshold=float(centroid_thr),
            detector=detector,
            sample_count=len(images),
            defect_classifier=defect_classifier,
        )

    def upsert_product(self, product: ProductModel) -> None:
        replaced = False
        for i, old in enumerate(self.products):
            if old.directory_name == product.directory_name:
                self.products[i] = product
                replaced = True
                break
        if not replaced:
            self.products.append(product)
        self.products.sort(key=lambda p: p.directory_name.lower())

    def rebuild_identity_classifier(self, progress: Optional[Callable[[str], None]] = None) -> None:
        self.identity_classifier = None
        self.classifier_prob_threshold = CLASSIFIER_MIN_PROB
        self.classifier_margin_threshold = CLASSIFIER_MIN_MARGIN
        if len(self.products) < 2:
            if progress:
                progress("Identity classifier: not needed for a single enrolled product.")
            return
        X = np.vstack([p.identity_bank for p in self.products]).astype(np.float32)
        y = np.asarray([p.directory_name for p in self.products for _ in range(len(p.identity_bank))], dtype=str)
        class_counts = {label: int(np.sum(y == label)) for label in np.unique(y)}
        min_count = min(class_counts.values())
        if min_count < 2:
            if progress:
                progress("Identity classifier: not enough examples in every product; using exemplar/centroid gates.")
            return
        clf = LogisticRegression(C=4.0, max_iter=2500, class_weight="balanced", solver="lbfgs", random_state=42)
        clf.fit(X, y)
        n_splits = min(5, min_count)
        if n_splits >= 2:
            cv = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)
            probs = cross_val_predict(clf, X, y, cv=cv, method="predict_proba", n_jobs=1)
            class_to_col = {str(label): i for i, label in enumerate(clf.classes_)}
            correct_prob = np.asarray([probs[i, class_to_col[str(y[i])]] for i in range(len(y))])
            top_sorted = np.sort(probs, axis=1)
            margins = top_sorted[:, -1] - top_sorted[:, -2] if probs.shape[1] >= 2 else np.ones(len(y), dtype=np.float32)
            self.classifier_prob_threshold = float(max(CLASSIFIER_MIN_PROB, np.percentile(correct_prob, 5.0) - 0.03))
            self.classifier_margin_threshold = float(max(CLASSIFIER_MIN_MARGIN, np.percentile(margins, 5.0) * 0.45))
        self.identity_classifier = clf
        if progress:
            progress(f"Identity classifier ready: {len(self.products)} products | probability gate≥{self.classifier_prob_threshold:.3f} | margin gate≥{self.classifier_margin_threshold:.3f}")

    def fit_all(self, product_datasets: list[tuple[str, str, list[np.ndarray], dict[str, list[np.ndarray]]]], progress: Optional[Callable[[str], None]] = None) -> None:
        if not product_datasets:
            raise ValueError("No labeled products were found in the dataset.")
        def report(message: str) -> None:
            if progress:
                progress(message)
        self.products = []
        for index, (name, directory_name, images, defect_datasets) in enumerate(product_datasets, 1):
            report(f"PRODUCT {index}/{len(product_datasets)} → {name}")
            product = self.fit_product(name, directory_name, images, defect_datasets=defect_datasets, progress=report)
            self.products.append(product)
        self.products.sort(key=lambda p: p.directory_name.lower())
        self.rebuild_identity_classifier(progress=report)
        self.created_at = now_text()

    def predict(self, roi_bgr: np.ndarray) -> tuple[str, bool, float, float, float, np.ndarray, float, float, str, float, float]:
        if not self.products:
            raise RuntimeError("No labeled product model is loaded.")
        query = self.extractor.identity_embeddings([roi_bgr], batch_size=1)[0]
        query /= max(float(np.linalg.norm(query)), 1e-8)
        probabilities: dict[str, float] = {}
        classifier_margin = math.inf
        classifier_pred: Optional[str] = None
        if self.identity_classifier is not None:
            prob_vector = self.identity_classifier.predict_proba(query.reshape(1, -1))[0]
            labels = [str(x) for x in self.identity_classifier.classes_]
            order = np.argsort(prob_vector)[::-1]
            classifier_pred = labels[int(order[0])]
            for i, label in enumerate(labels):
                probabilities[label] = float(prob_vector[i])
            classifier_margin = float(prob_vector[order[0]] - prob_vector[order[1]]) if len(order) >= 2 else 1.0
        scored = []
        for product in self.products:
            prob = probabilities.get(product.directory_name) if probabilities else None
            combined, nearest_mean, centroid_distance = self._product_score(query, product, prob)
            scored.append((combined, nearest_mean, centroid_distance, prob, product))
        scored.sort(key=lambda item: item[0])
        best_combined, nearest_mean, centroid_distance, best_prob, best = scored[0]
        exemplar_ok = nearest_mean <= best.identity_nn_threshold and centroid_distance <= best.identity_centroid_threshold
        if self.identity_classifier is not None:
            classifier_ok = classifier_pred == best.directory_name and (best_prob or 0.0) >= self.classifier_prob_threshold and classifier_margin >= self.classifier_margin_threshold
        else:
            classifier_ok = True
        identity_ok = exemplar_ok and classifier_ok
        if len(scored) > 1:
            second_combined = scored[1][0]
            relative_gap = (second_combined - best_combined) / max(abs(second_combined), 1e-6)
            if relative_gap < UNKNOWN_MARGIN_RATIO:
                identity_ok = False
        if not identity_ok:
            return ("UNKNOWN PRODUCT", True, 0.0, float(nearest_mean), float(best.identity_nn_threshold), np.zeros((roi_bgr.shape[0], roi_bgr.shape[1]), dtype=np.float32), 0.0, float(best_combined), "UNKNOWN_DEFECT", 0.0, 0.0)
        anomaly, anomaly_score, heatmap, anomaly_threshold = best.detector.predict(roi_bgr)
        defect_label = "NO_DEFECT_MODEL"
        defect_probability = 0.0
        defect_margin = 0.0
        if best.defect_classifier is not None:
            defect_label, defect_probability, defect_margin = best.defect_classifier.predict(roi_bgr)
        else:
            defect_label = "GOOD" if not anomaly else "UNKNOWN_ANOMALY"
        return (best.name, bool(anomaly), float(anomaly_score), float(nearest_mean), float(best.identity_nn_threshold), heatmap, float(anomaly_threshold), float(best_combined), defect_label, float(defect_probability), float(defect_margin))

    def _product_file(self, folder: Path, product: ProductModel) -> Path:
        subfolder = folder / "products"
        subfolder.mkdir(parents=True, exist_ok=True)
        filename = f"{sanitize_product_directory(product.directory_name)}.npz"
        return subfolder / filename

    def save(self, folder: Path) -> Path:
        folder.mkdir(parents=True, exist_ok=True)
        product_folder = folder / "products"
        product_folder.mkdir(parents=True, exist_ok=True)
        registry = {
            "format_version": MODEL_FORMAT_VERSION,
            "created_at": self.created_at or now_text(),
            "torch": torch.__version__,
            "torchvision": torchvision_version,
            "products": [],
            "classifier": {
                "present": self.identity_classifier is not None,
                "probability_threshold": self.classifier_prob_threshold,
                "margin_threshold": self.classifier_margin_threshold,
            },
        }
        live_files = set()
        for product in sorted(self.products, key=lambda p: p.directory_name.lower()):
            path = self._product_file(folder, product)
            live_files.add(path.resolve())
            arrays = product.detector.export()
            arrays.update({
                "model_format": np.array([MODEL_FORMAT_VERSION], dtype=np.int32),
                "product_name": np.array(product.name, dtype=str),
                "directory_name": np.array(product.directory_name, dtype=str),
                "identity_bank": product.identity_bank,
                "identity_centroid": product.identity_centroid,
                "identity_nn_threshold": np.array([product.identity_nn_threshold], dtype=np.float32),
                "identity_centroid_threshold": np.array([product.identity_centroid_threshold], dtype=np.float32),
                "sample_count": np.array([product.sample_count], dtype=np.int32),
            })
            if product.defect_classifier is not None:
                for key, value in product.defect_classifier.export().items():
                    arrays[f"defect_{key}"] = value
            else:
                arrays["defect_present"] = np.array([0], dtype=np.int32)
            np.savez_compressed(path, **arrays)
            registry["products"].append({
                "name": product.name,
                "directory_name": product.directory_name,
                "file": str(path.relative_to(folder)).replace("\\", "/"),
                "sample_count": product.sample_count,
                "defect_classes": product.defect_classifier.classes if product.defect_classifier is not None else [],
                "defect_sample_counts": product.defect_classifier.sample_counts if product.defect_classifier is not None else {},
            })
        for old in product_folder.glob("*.npz"):
            if old.resolve() not in live_files:
                try:
                    old.unlink()
                except OSError:
                    pass
        if self.identity_classifier is not None:
            np.savez_compressed(folder / "identity_classifier.npz", coef=np.asarray(self.identity_classifier.coef_, dtype=np.float32), intercept=np.asarray(self.identity_classifier.intercept_, dtype=np.float32), classes=np.asarray([str(x) for x in self.identity_classifier.classes_], dtype=str), n_features=np.array([self.identity_classifier.n_features_in_], dtype=np.int32), n_iter=np.asarray(getattr(self.identity_classifier, "n_iter_", [0]), dtype=np.int32))
        else:
            try:
                (folder / "identity_classifier.npz").unlink()
            except OSError:
                pass
        registry_path = folder / "registry.json"
        registry_path.write_text(json.dumps(registry, indent=2, ensure_ascii=False), encoding="utf-8")
        self.created_at = str(registry["created_at"])
        return registry_path

    def _load_classifier(self, folder: Path) -> None:
        self.identity_classifier = None
        classifier_path = folder / "identity_classifier.npz"
        registry_path = folder / "registry.json"
        if not classifier_path.exists() or not registry_path.exists():
            return
        registry = json.loads(registry_path.read_text(encoding="utf-8"))
        spec = registry.get("classifier", {})
        self.classifier_prob_threshold = float(spec.get("probability_threshold", CLASSIFIER_MIN_PROB))
        self.classifier_margin_threshold = float(spec.get("margin_threshold", CLASSIFIER_MIN_MARGIN))
        try:
            with np.load(classifier_path, allow_pickle=False) as data:
                clf = LogisticRegression(C=4.0, max_iter=2500, class_weight="balanced", solver="lbfgs", random_state=42)
                clf.classes_ = np.asarray(data["classes"], dtype=str)
                clf.coef_ = np.asarray(data["coef"], dtype=np.float64)
                clf.intercept_ = np.asarray(data["intercept"], dtype=np.float64)
                clf.n_features_in_ = int(np.asarray(data["n_features"]).reshape(-1)[0])
                clf.n_iter_ = np.asarray(data.get("n_iter", np.array([0])), dtype=np.int32)
                self.identity_classifier = clf
        except Exception:
            self.identity_classifier = None

    def load(self, folder: Path) -> Path:
        registry_path = folder / "registry.json"
        if not registry_path.exists():
            raise FileNotFoundError(f"No saved model registry found at:\n{registry_path}")
        registry = json.loads(registry_path.read_text(encoding="utf-8"))
        version = int(registry.get("format_version", -1))
        if version != MODEL_FORMAT_VERSION:
            raise RuntimeError(f"Saved model format {version} is not supported by V10. Rebuild the models from the current labeled datasets.")
        loaded: list[ProductModel] = []
        specs = registry.get("products", [])
        if not specs:
            raise RuntimeError("Saved model registry contains no products.")
        for spec in specs:
            path = folder / str(spec["file"])
            if not path.exists():
                raise FileNotFoundError(f"Missing product model file:\n{path}")
            with np.load(path, allow_pickle=False) as data:
                detector = PatchCoreDetector(self.extractor)
                detector.import_saved({"memory_bank": data["memory_bank"], "threshold": data["threshold"], "calibration_low": data["calibration_low"], "calibration_high": data["calibration_high"], "metadata": data["metadata"]})
                product_name = str(data["product_name"])
                directory_name = str(data["directory_name"])
                identity_bank = np.asarray(data["identity_bank"], dtype=np.float32)
                identity_centroid = np.asarray(data["identity_centroid"], dtype=np.float32)
                nn_thr = float(np.asarray(data["identity_nn_threshold"]).reshape(-1)[0])
                centroid_thr = float(np.asarray(data["identity_centroid_threshold"]).reshape(-1)[0])
                sample_count = int(np.asarray(data["sample_count"]).reshape(-1)[0])
                defect_classifier = None
                if "defect_present" in data or "defect_present" in data.files:
                    defect_classifier = ProductDefectClassifier(self.extractor)
                    defect_data = {key[len("defect_"):]: data[key] for key in data.files if key.startswith("defect_")}
                    defect_classifier.import_saved(defect_data)
                    if defect_classifier.classifier is None:
                        defect_classifier = None
            loaded.append(ProductModel(name=product_name, directory_name=directory_name, identity_bank=identity_bank, identity_centroid=identity_centroid, identity_nn_threshold=nn_thr, identity_centroid_threshold=centroid_thr, detector=detector, sample_count=sample_count, defect_classifier=defect_classifier))
        self.products = sorted(loaded, key=lambda p: p.directory_name.lower())
        self.created_at = str(registry.get("created_at", ""))
        self._load_classifier(folder)
        if self.identity_classifier is None and len(self.products) >= 2:
            self.rebuild_identity_classifier()
        return registry_path

    def summary(self) -> str:
        if not self.products:
            return "MODEL: no labeled products loaded"
        lines = [f"LABELED MODEL SET: {len(self.products)} product(s)", f"Created: {self.created_at}", f"Identity classifier: {'ON' if self.identity_classifier is not None else 'single-product/gates-only'}"]
        for product in self.products:
            defect_text = ", ".join(product.defect_classifier.classes) if product.defect_classifier is not None else "none (anomaly-only)"
            lines.append(f"• {product.name}: {product.sample_count} GOOD | defects: {defect_text} | ID NN≤{product.identity_nn_threshold:.4f} | centroid≤{product.identity_centroid_threshold:.4f} | anomaly≤{product.detector.threshold:.5f}")
        if self.identity_classifier is not None:
            lines.append(f"Product classifier gates: probability≥{self.classifier_prob_threshold:.3f}, margin≥{self.classifier_margin_threshold:.3f}")
        return "\n".join(lines)


# -----------------------------------------------------------------------------
# ESP32 controller
# -----------------------------------------------------------------------------
class ESP32Controller:
    """Lightweight serial HMI controller for Arduino UNO + ST7735S.

    The PC performs all vision/AI work. The UNO is intentionally kept small:
    it receives only short text commands and maintains a local PASS/FAIL count.
    No image streaming, CRC handshake, or large buffers are used.
    """

    SERIAL_BAUD = 115200

    def __init__(self):
        self.connection: Optional[serial.Serial] = None
        self.port = "AUTO"
        self.write_lock = threading.RLock()

    @staticmethod
    def available_ports() -> list[str]:
        return sorted(port.device for port in list_ports.comports())

    @classmethod
    def auto_port(cls) -> Optional[str]:
        ports = cls.available_ports()
        if not ports:
            return None
        preferred = [p for p in ports if any(tag in p.upper() for tag in ("USB", "SER", "COM"))]
        return preferred[0] if preferred else ports[0]

    def connect(self, requested_port: str, baud: int = SERIAL_BAUD) -> tuple[bool, str]:
        self.close()
        requested = (requested_port or "AUTO").strip()
        actual = self.auto_port() if requested.upper() == "AUTO" else requested
        if not actual:
            return False, "Arduino UNO: no serial port found."
        try:
            self.connection = serial.Serial(actual, baudrate=baud, timeout=0.2, write_timeout=1.0)
            self.port = actual
            # Opening the UNO serial port normally resets the board; give it time to boot.
            time.sleep(1.6)
            self.send("HELLO")
            return True, f"Arduino UNO: connected on {actual}"
        except Exception as exc:
            self.connection = None
            return False, f"Arduino UNO: connection failed on {actual}: {exc}"

    def is_connected(self) -> bool:
        return bool(self.connection and self.connection.is_open)

    @staticmethod
    def _safe_ascii_label(value: str, fallback: str = "UNKNOWN") -> str:
        text = (value or "").strip().replace("|", "_").replace("\r", "_").replace("\n", "_")
        encoded = text.encode("ascii", errors="replace").decode("ascii")
        encoded = "".join(ch if 32 <= ord(ch) <= 126 else "_" for ch in encoded)
        return encoded[:42] if encoded else fallback

    def send(self, command: str) -> bool:
        if not self.is_connected():
            return False
        try:
            with self.write_lock:
                self.connection.write((command.strip() + "\n").encode("ascii", errors="replace"))
                self.connection.flush()
            return True
        except Exception:
            return False

    def send_result(self, status: str, product: str, defect: str, cycle_ms: float) -> bool:
        status = "PASS" if str(status).upper() == "PASS" else "FAIL"
        product = self._safe_ascii_label(product, "UNKNOWN_PRODUCT")
        defect = self._safe_ascii_label(defect, "GOOD" if status == "PASS" else "UNKNOWN_DEFECT")
        cycle = max(0, int(round(float(cycle_ms))))
        return self.send(f"RESULT|{status}|{product}|{defect}|{cycle}")

    def send_stats(self, total: int, passed: int, failed: int, avg_cycle_ms: float) -> bool:
        return self.send(
            f"STATS|{int(total)}|{int(passed)}|{int(failed)}|{max(0, int(round(avg_cycle_ms)))}"
        )

    def close(self) -> None:
        if self.connection:
            try:
                self.connection.close()
            except Exception:
                pass
        self.connection = None


