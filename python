# =============================================================================
# V14 OBJECT LOCALIZATION + FIXED REFERENCE WINDOW PATCH
# =============================================================================
# The V13 contour selector could choose only the dominant connected contour.
# For industrial parts this is unsafe when a part contains thin/disconnected
# accessories (spray nozzles, caps, tabs, handles, necks, etc.). V14 therefore:
#   1) builds a foreground mask from color difference to the border background;
#   2) extracts multiple connected components;
#   3) starts from the strongest central component and grows a spatially-near
#      component group, so nearby thin/disconnected object pieces are retained;
#   4) uses the grouped bounding box for presentation/identity localization;
#   5) learns a per-product FIXED REFERENCE WINDOW from GOOD images;
#   6) trains PatchCore/defect classification on that fixed window, not on a
#      test-time tight crop. Thus removing a cap/nozzle cannot simply shrink the
#      crop and get normalized away.
# This follows the patch-based nature of PatchCore: patch features are stored in
# a memory bank and compared at inference, with an anomaly map for localization.
# See OpenCV connected-component/contour docs and Anomalib PatchCore docs.

V14_REFERENCE_PADDING_RATIO = 0.06
V14_REFERENCE_QUANTILE_LOW = 0.10
V14_REFERENCE_QUANTILE_HIGH = 0.90
V14_COMPONENT_MIN_AREA_RATIO = 0.00045
V14_COMPONENT_MAIN_MIN_AREA_RATIO = 0.0040
V14_COMPONENT_LINK_DISTANCE_RATIO = 0.24
V14_COMPONENT_LINK_DISTANCE_MIN = 7
V14_COMPONENT_LINK_DISTANCE_MAX = 55
V14_COMPONENT_SLENDER_MIN_RATIO = 3.0
V14_COMPONENT_SLENDER_MIN_AREA_RATIO = 0.00020
V14_COMPONENT_MAX_NOISE_RATIO = 0.20
V14_REFERENCE_ID_MIN_THRESHOLD = 0.055
V14_REFERENCE_ID_MAX_THRESHOLD = 0.20
V14_REFERENCE_ID_MARGIN = 1.10


def _v14_bbox_gap(a: tuple[int, int, int, int], b: tuple[int, int, int, int]) -> float:
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    ax2, ay2 = ax + aw, ay + ah
    bx2, by2 = bx + bw, by + bh
    dx = max(ax, bx) - min(ax2, bx2)
    dy = max(ay, by) - min(ay2, by2)
    gx = max(0.0, float(dx))
    gy = max(0.0, float(dy))
    return float(math.hypot(gx, gy))


def _v14_foreground_masks(image: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
    """Return robust color and edge-supported foreground masks."""
    h, w = image.shape[:2]
    border = _border_pixels(image, border=max(6, min(12, min(h, w) // 10)))
    lab = cv2.cvtColor(image, cv2.COLOR_BGR2LAB).astype(np.float32)
    border_lab = cv2.cvtColor(border.reshape(-1, 1, 3), cv2.COLOR_BGR2LAB).reshape(-1, 3)
    bg = np.median(border_lab, axis=0)

    dist = np.linalg.norm(lab - bg.reshape(1, 1, 3), axis=2)
    dist = cv2.GaussianBlur(dist.astype(np.float32), (5, 5), 0)
    d8 = cv2.normalize(dist, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)

    # Otsu captures the dominant foreground-vs-background split.
    _, otsu = cv2.threshold(d8, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
    # A lower adaptive relative threshold helps retain thin/low-contrast pieces.
    q = float(np.percentile(d8, 82.0))
    adaptive = np.uint8(d8 >= max(8.0, min(170.0, q * 0.62))) * 255

    color_mask = cv2.bitwise_or(otsu, adaptive)
    close_kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))
    color_mask = cv2.morphologyEx(color_mask, cv2.MORPH_CLOSE, close_kernel, iterations=2)
    color_mask = cv2.morphologyEx(color_mask, cv2.MORPH_OPEN, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3)), iterations=1)

    # Edge support is intentionally not used as a standalone detector. It is
    # dilated and later accepted only if spatially linked to the main object.
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    edges = cv2.Canny(gray, 35, 110)
    edges = cv2.dilate(edges, cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3)), iterations=1)
    return color_mask, edges


def _v14_estimate_object_bbox(image: np.ndarray) -> tuple[int, int, int, int]:
    """Multi-component industrial object localization.

    Unlike the old RETR_EXTERNAL + largest-contour strategy, this function
    keeps a connected group of spatially related components. It is designed to
    retain thin/disconnected parts such as spray heads, caps, tabs and nozzles.
    """
    if image is None or image.size == 0:
        raise ValueError("Empty image received for object localization.")
    h, w = image.shape[:2]
    if h < 32 or w < 32:
        return 0, 0, w, h

    try:
        color_mask, edges = _v14_foreground_masks(image)
        # Make a conservative union. Later component grouping rejects isolated
        # edge noise, while thin real parts remain candidates.
        support = cv2.bitwise_or(color_mask, edges)
        support = cv2.morphologyEx(
            support,
            cv2.MORPH_CLOSE,
            cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5)),
            iterations=1,
        )

        num, labels, stats, centroids = cv2.connectedComponentsWithStats(support, connectivity=8)
        total = float(h * w)
        components: list[tuple[int, tuple[int, int, int, int], float, float]] = []
        cx0, cy0 = w * 0.5, h * 0.5
        for idx in range(1, num):
            x = int(stats[idx, cv2.CC_STAT_LEFT])
            y = int(stats[idx, cv2.CC_STAT_TOP])
            bw = int(stats[idx, cv2.CC_STAT_WIDTH])
            bh = int(stats[idx, cv2.CC_STAT_HEIGHT])
            area = float(stats[idx, cv2.CC_STAT_AREA])
            if bw < 2 or bh < 2:
                continue
            area_ratio = area / max(total, 1.0)
            if area_ratio < V14_COMPONENT_MIN_AREA_RATIO:
                slender = max(bw, bh) / max(1.0, min(bw, bh))
                if area_ratio < V14_COMPONENT_SLENDER_MIN_AREA_RATIO or slender < V14_COMPONENT_SLENDER_MIN_RATIO:
                    continue
            if area_ratio > 0.985:
                continue
            ccx = float(centroids[idx][0])
            ccy = float(centroids[idx][1])
            center_d = math.hypot((ccx - cx0) / max(cx0, 1.0), (ccy - cy0) / max(cy0, 1.0))
            rectangularity = min(1.0, area / max(float(bw * bh), 1.0))
            centrality = 1.0 / (1.0 + 2.0 * center_d * center_d)
            score = area * (0.70 + 0.30 * centrality) * (0.85 + 0.15 * rectangularity)
            components.append((idx, (x, y, bw, bh), score, area))

        if not components:
            return 0, 0, w, h

        # Primary body component: usually the largest useful central component.
        primary_candidates = [c for c in components if c[3] / total >= V14_COMPONENT_MAIN_MIN_AREA_RATIO]
        if not primary_candidates:
            primary_candidates = components
        primary = max(primary_candidates, key=lambda c: c[2])
        selected = [primary]
        selected_ids = {primary[0]}
        group_box = primary[1]

        # Iteratively absorb nearby components. The link radius scales with the
        # current object size, so a tall bottle can retain a separated nozzle,
        # while random far-away blobs are ignored.
        changed = True
        while changed:
            changed = False
            gx, gy, gw, gh = group_box
            dynamic_link = int(round(max(
                V14_COMPONENT_LINK_DISTANCE_MIN,
                min(V14_COMPONENT_LINK_DISTANCE_MAX, V14_COMPONENT_LINK_DISTANCE_RATIO * max(gw, gh)),
            )))
            expanded = (gx - dynamic_link, gy - dynamic_link, gw + 2 * dynamic_link, gh + 2 * dynamic_link)
            for comp in components:
                idx, box, score, area = comp
                if idx in selected_ids:
                    continue
                gap = _v14_bbox_gap(expanded, box)
                bx, by, bw, bh = box
                inside_expanded = not (
                    bx + bw < expanded[0]
                    or by + bh < expanded[1]
                    or bx > expanded[0] + expanded[2]
                    or by > expanded[1] + expanded[3]
                )
                area_ratio = area / total
                slender = max(bw, bh) / max(1.0, min(bw, bh))
                allow_small = area_ratio >= V14_COMPONENT_SLENDER_MIN_AREA_RATIO and slender >= V14_COMPONENT_SLENDER_MIN_RATIO
                if inside_expanded or gap <= dynamic_link or allow_small and gap <= dynamic_link * 1.6:
                    selected.append(comp)
                    selected_ids.add(idx)
                    x1 = min(gx, bx)
                    y1 = min(gy, by)
                    x2 = max(gx + gw, bx + bw)
                    y2 = max(gy + gh, by + bh)
                    group_box = (x1, y1, x2 - x1, y2 - y1)
                    changed = True
                    gx, gy, gw, gh = group_box

        # Add a modest pad so the model does not clip thin edges. Keep it tied to
        # the complete grouped object, not to the biggest single component.
        x, y, bw, bh = group_box
        pad = max(3, int(round(V14_REFERENCE_PADDING_RATIO * max(bw, bh))))
        x1 = max(0, x - pad)
        y1 = max(0, y - pad)
        x2 = min(w, x + bw + pad)
        y2 = min(h, y + bh + pad)
        return int(x1), int(y1), int(max(16, x2 - x1)), int(max(16, y2 - y1))
    except (cv2.error, ValueError, TypeError):
        return 0, 0, w, h


# Make the improved localization the single source of truth for V14. All V9/V10
# identity/position paths that call estimate_object_bbox now see the complete group.
estimate_object_bbox = _v14_estimate_object_bbox


def _v14_canonicalize_fixed_window(
    image: np.ndarray,
    reference_bbox: tuple[int, int, int, int],
) -> tuple[np.ndarray, tuple[int, int, int, int]]:
    """Canonicalize a fixed learned window without re-fitting it to the test object."""
    h, w = image.shape[:2]
    x, y, bw, bh = [int(v) for v in reference_bbox]
    x = max(0, min(x, max(0, w - 1)))
    y = max(0, min(y, max(0, h - 1)))
    bw = max(8, min(bw, w - x))
    bh = max(8, min(bh, h - y))
    crop = image[y:y + bh, x:x + bw].copy()
    if crop.size == 0:
        return canonicalize_object(image)
    border = _border_pixels(image)
    bg_color = np.median(border, axis=0).astype(np.uint8)
    side = max(bw, bh)
    canvas = np.empty((side, side, 3), dtype=np.uint8)
    canvas[:] = bg_color
    ox = (side - bw) // 2
    oy = (side - bh) // 2
    canvas[oy:oy + bh, ox:ox + bw] = crop
    canonical = cv2.resize(canvas, (INPUT_SIZE, INPUT_SIZE), interpolation=cv2.INTER_AREA)
    return canonical, (x, y, bw, bh)


def _v14_compute_reference_bbox(images: list[np.ndarray]) -> Optional[tuple[int, int, int, int]]:
    """Robust per-product reference window from GOOD localization boxes."""
    boxes = []
    h = w = None
    for image in images:
        if image is None or image.size == 0:
            continue
        ih, iw = image.shape[:2]
        h, w = ih, iw
        box = _v14_estimate_object_bbox(image)
        bx, by, bw, bh = box
        area_ratio = (bw * bh) / max(float(iw * ih), 1.0)
        if area_ratio < 0.004 or area_ratio > 0.92:
            continue
        boxes.append(box)
    if not boxes or h is None or w is None:
        return None
    arr = np.asarray(boxes, dtype=np.float32)
    left = arr[:, 0]
    top = arr[:, 1]
    right = arr[:, 0] + arr[:, 2]
    bottom = arr[:, 1] + arr[:, 3]
    x1 = float(np.percentile(left, V14_REFERENCE_QUANTILE_LOW))
    y1 = float(np.percentile(top, V14_REFERENCE_QUANTILE_LOW))
    x2 = float(np.percentile(right, V14_REFERENCE_QUANTILE_HIGH))
    y2 = float(np.percentile(bottom, V14_REFERENCE_QUANTILE_HIGH))
    width = max(16.0, x2 - x1)
    height = max(16.0, y2 - y1)
    pad = max(4.0, V14_REFERENCE_PADDING_RATIO * max(width, height))
    x1 = max(0.0, x1 - pad)
    y1 = max(0.0, y1 - pad)
    x2 = min(float(w), x2 + pad)
    y2 = min(float(h), y2 + pad)
    return int(round(x1)), int(round(y1)), int(round(max(16.0, x2 - x1))), int(round(max(16.0, y2 - y1)))


def _v14_reference_identity_threshold(bank: np.ndarray) -> float:
    bank = np.asarray(bank, dtype=np.float32)
    if len(bank) <= 1:
        return V14_REFERENCE_ID_MAX_THRESHOLD
    centroid = bank.mean(axis=0)
    centroid /= max(float(np.linalg.norm(centroid)), 1e-8)
    distances = cosine_distance(centroid, bank)
    threshold = robust_upper(distances, V14_REFERENCE_ID_MARGIN, floor=V14_REFERENCE_ID_MIN_THRESHOLD)
    return float(min(V14_REFERENCE_ID_MAX_THRESHOLD, max(V14_REFERENCE_ID_MIN_THRESHOLD, threshold)))


def _v14_patch_fit(
    self: PatchCoreDetector,
    images: list[np.ndarray],
    reference_bbox: Optional[tuple[int, int, int, int]] = None,
    progress: Optional[Callable[[str], None]] = None,
) -> DetectorInfo:
    if reference_bbox is None:
        # Keep backward compatibility with old V10/V13 models.
        return _v14_original_patch_fit(self, images, progress=progress)
    if len(images) < TRAIN_MINIMUM:
        raise ValueError(f"A product needs at least {TRAIN_MINIMUM} GOOD images. Received {len(images)}.")

    def report(message: str) -> None:
        if progress:
            progress(message)

    canonical_images = [_v14_canonicalize_fixed_window(img, reference_bbox)[0] for img in images]
    report(f"Extracting FIXED-WINDOW patch features from {len(canonical_images)} GOOD images...")
    per_image, grid = self.extractor.patch_embedding_lists(canonical_images, batch_size=8, already_canonical=True)
    raw_patch_count = int(sum(len(x) for x in per_image))

    indices = np.arange(len(canonical_images))
    rng = np.random.default_rng(42)
    rng.shuffle(indices)
    fold_count = 3 if len(indices) >= 24 else 2
    folds = np.array_split(indices, fold_count)
    validation_scores: list[float] = []
    validation_distances: list[np.ndarray] = []
    for fold_no, val_idx in enumerate(folds, 1):
        train_idx = np.concatenate([fold for j, fold in enumerate(folds) if j != fold_no - 1])
        train_features = np.vstack([per_image[i] for i in train_idx])
        target = max(128, int(len(train_features) * CORESET_RATIO))
        target = min(target, len(train_features), CORESET_MAX_MEMORY)
        memory = self._greedy_coreset(train_features, target, seed=100 + fold_no)
        knn = self._make_knn(memory)
        for i in val_idx:
            score, distances = self._score_features(per_image[i], knn)
            validation_scores.append(score)
            validation_distances.append(distances)
        report(f"Fixed-window anomaly calibration fold {fold_no}/{fold_count} complete.")
    score_array = np.asarray(validation_scores, dtype=np.float32)
    self.threshold = robust_upper(score_array, ANOMALY_THRESHOLD_MARGIN, floor=1e-6)
    all_distances = np.concatenate(validation_distances) if validation_distances else np.array([0.0])
    self.calibration_low = float(np.percentile(all_distances, 50.0))
    self.calibration_high = float(np.percentile(all_distances, 99.5))
    if self.calibration_high <= self.calibration_low:
        self.calibration_high = self.calibration_low + 1e-6
    all_features = np.vstack(per_image)
    target = max(128, int(len(all_features) * CORESET_RATIO))
    target = min(target, len(all_features), CORESET_MAX_MEMORY)
    self.memory_bank = self._greedy_coreset(all_features, target, seed=42)
    self.knn = self._make_knn(self.memory_bank)
    self.info = DetectorInfo(
        num_good_images=len(images),
        memory_bank_size=len(self.memory_bank),
        raw_patch_count=raw_patch_count,
        threshold=float(self.threshold),
        created_at=now_text(),
    )
    report(
        f"Fixed-window Patch model ready: {grid[0]}x{grid[1]} patches/image | threshold={self.threshold:.5f}"
    )
    return self.info


_v14_original_patch_fit = PatchCoreDetector.fit
PatchCoreDetector.fit = _v14_patch_fit


def _v14_patch_predict(
    self: PatchCoreDetector,
    roi_bgr: np.ndarray,
    canonical_image: Optional[np.ndarray] = None,
    validated_bbox: Optional[tuple[int, int, int, int]] = None,
    reference_bbox: Optional[tuple[int, int, int, int]] = None,
) -> tuple[bool, float, np.ndarray, float]:
    if self.knn is None:
        raise RuntimeError("Patch model is not loaded.")
    if canonical_image is not None:
        canonical = canonical_image
        used_box = reference_bbox or validated_bbox or estimate_object_bbox(roi_bgr)
    elif reference_bbox is not None:
        canonical, used_box = _v14_canonicalize_fixed_window(roi_bgr, reference_bbox)
    elif validated_bbox is not None:
        canonical, used_box = _v13_canonicalize_from_bbox(roi_bgr, validated_bbox)
    else:
        canonical, used_box = canonicalize_object(roi_bgr)
    per_image, grid = self.extractor.patch_embedding_lists([canonical], batch_size=1, already_canonical=True)
    score, distances = self._score_features(per_image[0], self.knn)
    is_anomaly = score > self.threshold
    patch_map = distances.reshape(grid)
    denominator = max(self.calibration_high - self.calibration_low, 1e-6)
    heat = np.clip((patch_map - self.calibration_low) / denominator, 0.0, 1.0)
    heat = cv2.resize(heat, (INPUT_SIZE, INPUT_SIZE), interpolation=cv2.INTER_CUBIC)
    blur = HEATMAP_BLUR if HEATMAP_BLUR % 2 else HEATMAP_BLUR + 1
    heat = cv2.GaussianBlur(heat, (blur, blur), 0)
    full_heat = np.zeros((roi_bgr.shape[0], roi_bgr.shape[1]), dtype=np.float32)
    x, y, bw, bh = used_box
    x2 = min(full_heat.shape[1], x + bw)
    y2 = min(full_heat.shape[0], y + bh)
    if x2 > x and y2 > y:
        restored = cv2.resize(heat, (x2 - x, y2 - y), interpolation=cv2.INTER_CUBIC)
        full_heat[y:y2, x:x2] = restored
    return bool(is_anomaly), float(score), full_heat.astype(np.float32), float(self.threshold)


PatchCoreDetector.predict = _v14_patch_predict


# Patch the defect classifier so GOOD and defect classes use the same product
# reference window. This prevents a missing top component from being normalized
# away by a tighter test-time crop.
def _v14_defect_fit(
    self: ProductDefectClassifier,
    class_datasets: dict[str, list[np.ndarray]],
    progress: Optional[Callable[[str], None]] = None,
    reference_bbox: Optional[tuple[int, int, int, int]] = None,
) -> None:
    cleaned = {str(k).strip(): v for k, v in class_datasets.items() if str(k).strip() and v}
    if "GOOD" not in cleaned:
        raise ValueError("Defect training requires a GOOD class.")
    defect_classes = [k for k in cleaned if k != "GOOD"]
    if not defect_classes:
        self.classifier = None
        self.sample_counts = {"GOOD": len(cleaned["GOOD"])}
        if progress:
            progress("No user-defined defects exist yet; GOOD-only anomaly detection remains active.")
        return
    for label, images in cleaned.items():
        if len(images) < DEFECT_MINIMUM_PER_CLASS:
            raise ValueError(
                f"Defect class '{label}' needs at least {DEFECT_MINIMUM_PER_CLASS} images; received {len(images)}."
            )
    if progress:
        progress(f"Extracting fixed-window supervised defect features for {len(cleaned)} classes...")
    X_parts = []
    y_parts = []
    self.sample_counts = {}
    for label in sorted(cleaned.keys()):
        images = cleaned[label]
        if reference_bbox is not None:
            canonical_images = [_v14_canonicalize_fixed_window(img, reference_bbox)[0] for img in images]
            feats = self.extractor.defect_embeddings_for_canonical(canonical_images)
        else:
            feats = self.extractor.defect_embeddings(images)
        X_parts.append(feats)
        y_parts.extend([label] * len(images))
        self.sample_counts[label] = len(images)
    X = np.vstack(X_parts).astype(np.float32)
    y = np.asarray(y_parts, dtype=str)
    clf = LogisticRegression(
        C=DEFECT_CLASSIFIER_C,
        max_iter=3000,
        class_weight="balanced",
        solver="lbfgs",
        random_state=42,
    )
    clf.fit(X, y)
    counts = {label: int(np.sum(y == label)) for label in np.unique(y)}
    min_count = min(counts.values())
    prob_threshold = DEFECT_MIN_PROB
    margin_threshold = DEFECT_MIN_MARGIN
    if min_count >= 3 and len(np.unique(y)) >= 2:
        n_splits = min(5, min_count)
        try:
            cv = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)
            probs = cross_val_predict(clf, X, y, cv=cv, method="predict_proba", n_jobs=1)
            labels = [str(x) for x in clf.classes_]
            idx_map = {label: i for i, label in enumerate(labels)}
            correct_prob = np.asarray([probs[i, idx_map[str(y[i])]] for i in range(len(y))])
            ordered = np.sort(probs, axis=1)
            margins = ordered[:, -1] - ordered[:, -2] if probs.shape[1] >= 2 else np.ones(len(y))
            prob_threshold = max(DEFECT_MIN_PROB, float(np.percentile(correct_prob, 5.0)) - 0.03)
            margin_threshold = max(DEFECT_MIN_MARGIN, float(np.percentile(margins, 5.0)) * 0.45)
        except Exception:
            pass
    self.classifier = clf
    self.probability_threshold = prob_threshold
    self.margin_threshold = margin_threshold
    if progress:
        progress(
            f"Defect classifier ready: {', '.join(self.classes)} | probability≥{prob_threshold:.3f} | margin≥{margin_threshold:.3f}"
        )


def _v14_defect_predict(
    self: ProductDefectClassifier,
    image: np.ndarray,
    already_canonical: bool = False,
    reference_bbox: Optional[tuple[int, int, int, int]] = None,
) -> tuple[str, float, float]:
    if self.classifier is None:
        return "NO_DEFECT_MODEL", 0.0, 0.0
    if already_canonical:
        feature = self.extractor.defect_embeddings_for_canonical([image])[0]
    elif reference_bbox is not None:
        canonical = _v14_canonicalize_fixed_window(image, reference_bbox)[0]
        feature = self.extractor.defect_embeddings_for_canonical([canonical])[0]
    else:
        feature = self.extractor.defect_embeddings([image])[0]
    probs = self.classifier.predict_proba(feature.reshape(1, -1))[0]
    order = np.argsort(probs)[::-1]
    best_i = int(order[0])
    label = str(self.classifier.classes_[best_i])
    prob = float(probs[best_i])
    margin = float(probs[order[0]] - probs[order[1]]) if len(order) >= 2 else 1.0
    if prob < self.probability_threshold or margin < self.margin_threshold:
        return "UNKNOWN_DEFECT", prob, margin
    return label, prob, margin

ProductDefectClassifier.fit = _v14_defect_fit
ProductDefectClassifier.predict = _v14_defect_predict


# Extend ProductModel instances with optional per-product fixed reference data
# without breaking loading of older V10/V13 files.
def _v14_attach_product_reference(
    product: ProductModel,
    reference_bbox: Optional[tuple[int, int, int, int]],
    reference_identity_bank: Optional[np.ndarray],
    reference_identity_threshold: float,
) -> ProductModel:
    product.reference_bbox = tuple(reference_bbox) if reference_bbox is not None else None
    product.reference_identity_bank = (
        np.asarray(reference_identity_bank, dtype=np.float32)
        if reference_identity_bank is not None else None
    )
    product.reference_identity_threshold = float(reference_identity_threshold)
    return product


_v14_original_fit_product = LabeledProductModel.fit_product
_v14_original_save = LabeledProductModel.save
_v14_original_load = LabeledProductModel.load


def _v14_fit_product(
    self: LabeledProductModel,
    name: str,
    directory_name: str,
    images: list[np.ndarray],
    defect_datasets: Optional[dict[str, list[np.ndarray]]] = None,
    progress: Optional[Callable[[str], None]] = None,
) -> ProductModel:
    if len(images) < TRAIN_MINIMUM:
        raise ValueError(f"Product '{name}' needs at least {TRAIN_MINIMUM} GOOD images. Received {len(images)}.")
    def report(msg: str) -> None:
        if progress:
            progress(msg)

    report(f"{name}: V14 multi-component localization + fixed reference window...")
    reference_bbox = _v14_compute_reference_bbox(images)
    if reference_bbox is None:
        raise ValueError(f"Product '{name}' could not be localized reliably in its GOOD images.")
    report(f"{name}: reference window={reference_bbox} | complete-object localization enabled")

    # V9/V10 identity core: tight multi-component canonicalization remains the
    # primary recognition representation.
    identity_bank = self.extractor.identity_embeddings(images)
    identity_bank = identity_bank / np.maximum(np.linalg.norm(identity_bank, axis=1, keepdims=True), 1e-8)
    centroid = identity_bank.mean(axis=0)
    centroid /= max(float(np.linalg.norm(centroid)), 1e-8)
    augmented_images = identity_augmentations_for_images(images)
    augmented_embeddings = self.extractor.identity_embeddings(augmented_images, already_canonical=True)
    augmented_embeddings = augmented_embeddings / np.maximum(np.linalg.norm(augmented_embeddings, axis=1, keepdims=True), 1e-8)
    nn_thr, centroid_thr = self._calibrate_identity_thresholds(identity_bank, augmented_embeddings)
    report(f"{name}: identity gates | nearest≤{nn_thr:.4f} | centroid≤{centroid_thr:.4f}")

    # Fixed-reference identity fallback. This is specifically for cases where a
    # defect removes an outer component and a tight crop becomes misleading.
    ref_canonical = [_v14_canonicalize_fixed_window(img, reference_bbox)[0] for img in images]
    ref_bank = self.extractor.identity_embeddings(ref_canonical, already_canonical=True)
    ref_bank = ref_bank / np.maximum(np.linalg.norm(ref_bank, axis=1, keepdims=True), 1e-8)
    ref_thr = _v14_reference_identity_threshold(ref_bank)

    detector = PatchCoreDetector(self.extractor)
    detector.fit(images, reference_bbox=reference_bbox, progress=lambda msg: report(f"{name}: {msg}"))

    defect_classifier: Optional[ProductDefectClassifier] = None
    if defect_datasets is not None and any(k != "GOOD" for k in defect_datasets):
        defect_classifier = ProductDefectClassifier(self.extractor)
        defect_classifier.fit(
            defect_datasets,
            progress=lambda msg: report(f"{name}: {msg}"),
            reference_bbox=reference_bbox,
        )
    else:
        report(f"{name}: no supervised defect classes; GOOD-only anomaly inspection remains active.")

    product = ProductModel(
        name=name,
        directory_name=directory_name,
        identity_bank=identity_bank.astype(np.float32),
        identity_centroid=centroid.astype(np.float32),
        identity_nn_threshold=float(nn_thr),
        identity_centroid_threshold=float(centroid_thr),
        detector=detector,
        sample_count=len(images),
        defect_classifier=defect_classifier,
    )
    return _v14_attach_product_reference(product, reference_bbox, ref_bank, ref_thr)


LabeledProductModel.fit_product = _v14_fit_product


def _v14_predict(
    self: LabeledProductModel,
    roi_bgr: np.ndarray,
    validated_bbox: Optional[tuple[int, int, int, int]] = None,
) -> tuple[str, bool, float, float, float, np.ndarray, float, float, str, float, float]:
    if not self.products:
        raise RuntimeError("No labeled product model is loaded.")

    # Primary identity: V9/V10-style tight multi-component object view.
    if validated_bbox is None:
        canonical, used_bbox = canonicalize_object(roi_bgr)
    else:
        canonical, used_bbox = _v13_canonicalize_from_bbox(roi_bgr, validated_bbox)
    query = self.extractor.identity_embeddings([canonical], batch_size=1, already_canonical=True)[0]
    query /= max(float(np.linalg.norm(query)), 1e-8)

    scored = []
    for product in self.products:
        combined, nearest_mean, centroid_distance = self._product_score(query, product, None)
        scored.append((combined, nearest_mean, centroid_distance, product))
    scored.sort(key=lambda item: item[0])
    best_combined, nearest_mean, centroid_distance, best = scored[0]
    exemplar_ok = nearest_mean <= best.identity_nn_threshold and centroid_distance <= best.identity_centroid_threshold
    identity_ok = exemplar_ok

    # The V14 fallback is critical for defects that remove an external piece.
    # Compare the same camera ROI against each product's fixed reference window.
    fallback_product = None
    fallback_distance = math.inf
    for product in self.products:
        ref_box = getattr(product, "reference_bbox", None)
        ref_bank = getattr(product, "reference_identity_bank", None)
        if ref_box is None or ref_bank is None or len(ref_bank) == 0:
            continue
        ref_canonical, _ = _v14_canonicalize_fixed_window(roi_bgr, tuple(ref_box))
        ref_query = self.extractor.identity_embeddings([ref_canonical], batch_size=1, already_canonical=True)[0]
        ref_query /= max(float(np.linalg.norm(ref_query)), 1e-8)
        distances = cosine_distance(ref_query, ref_bank)
        d = float(np.min(distances))
        if d < fallback_distance:
            fallback_distance = d
            fallback_product = product
    if not identity_ok and fallback_product is not None:
        fallback_threshold = float(getattr(fallback_product, "reference_identity_threshold", V14_REFERENCE_ID_MAX_THRESHOLD))
        if fallback_distance <= fallback_threshold:
            best = fallback_product
            best_combined = min(best_combined, fallback_distance)
            # UI identity distance remains meaningful; use fallback distance.
            nearest_mean = fallback_distance
            centroid_distance = fallback_distance
            identity_ok = True

    if not identity_ok:
        return (
            "UNKNOWN PRODUCT", True, 0.0, float(nearest_mean),
            float(best.identity_nn_threshold),
            np.zeros((roi_bgr.shape[0], roi_bgr.shape[1]), dtype=np.float32),
            0.0, float(best_combined), "UNKNOWN_DEFECT", 0.0, 0.0,
        )

    # IMPORTANT: anomaly and known-defect recognition use the product's fixed
    # reference window. The test bbox is never used to shrink this representation.
    ref_box = getattr(best, "reference_bbox", None)
    if ref_box is not None:
        anomaly, anomaly_score, heatmap, anomaly_threshold = best.detector.predict(
            roi_bgr, reference_bbox=tuple(ref_box)
        )
        defect_label = "NO_DEFECT_MODEL"
        defect_probability = 0.0
        defect_margin = 0.0
        if best.defect_classifier is not None:
            defect_label, defect_probability, defect_margin = best.defect_classifier.predict(
                roi_bgr, reference_bbox=tuple(ref_box)
            )
    else:
        anomaly, anomaly_score, heatmap, anomaly_threshold = best.detector.predict(
            roi_bgr, canonical_image=canonical, validated_bbox=used_bbox
        )
        defect_label = "NO_DEFECT_MODEL"
        defect_probability = 0.0
        defect_margin = 0.0
        if best.defect_classifier is not None:
            defect_label, defect_probability, defect_margin = best.defect_classifier.predict(
                canonical, already_canonical=True
            )
    if best.defect_classifier is None:
        defect_label = "GOOD" if not anomaly else "UNKNOWN_ANOMALY"

    return (
        best.name, bool(anomaly), float(anomaly_score), float(nearest_mean),
        float(best.identity_nn_threshold), heatmap, float(anomaly_threshold),
        float(best_combined), defect_label, float(defect_probability), float(defect_margin),
    )


LabeledProductModel.predict = _v14_predict


# Persist the reference window and fallback identity bank alongside the normal
# V10 model arrays. Existing models without these fields still load safely.
def _v14_save(self: LabeledProductModel, folder: Path) -> Path:
    folder.mkdir(parents=True, exist_ok=True)
    product_folder = folder / "products"
    product_folder.mkdir(parents=True, exist_ok=True)
    registry = {
        "format_version": MODEL_FORMAT_VERSION,
        "created_at": self.created_at or now_text(),
        "torch": torch.__version__,
        "torchvision": torchvision_version,
        "products": [],
        "classifier": {
            "present": self.identity_classifier is not None,
            "probability_threshold": self.classifier_prob_threshold,
            "margin_threshold": self.classifier_margin_threshold,
        },
        "v14_geometry": {
            "multi_component_localization": True,
            "fixed_reference_window": True,
            "description": "V14 uses grouped foreground components for localization and per-product fixed reference windows for anomaly/defect inspection.",
        },
    }
    live_files = set()
    for product in sorted(self.products, key=lambda p: p.directory_name.lower()):
        path = self._product_file(folder, product)
        live_files.add(path.resolve())
        arrays = product.detector.export()
        arrays.update({
            "model_format": np.array([MODEL_FORMAT_VERSION], dtype=np.int32),
            "product_name": np.array(product.name, dtype=str),
            "directory_name": np.array(product.directory_name, dtype=str),
            "identity_bank": product.identity_bank,
            "identity_centroid": product.identity_centroid,
            "identity_nn_threshold": np.array([product.identity_nn_threshold], dtype=np.float32),
            "identity_centroid_threshold": np.array([product.identity_centroid_threshold], dtype=np.float32),
            "sample_count": np.array([product.sample_count], dtype=np.int32),
        })
        ref_box = getattr(product, "reference_bbox", None)
        ref_bank = getattr(product, "reference_identity_bank", None)
        if ref_box is not None and ref_bank is not None:
            arrays["reference_bbox"] = np.asarray(ref_box, dtype=np.int32)
            arrays["reference_identity_bank"] = np.asarray(ref_bank, dtype=np.float32)
            arrays["reference_identity_threshold"] = np.array([
                float(getattr(product, "reference_identity_threshold", V14_REFERENCE_ID_MAX_THRESHOLD))
            ], dtype=np.float32)
        else:
            arrays["reference_bbox"] = np.array([], dtype=np.int32)
            arrays["reference_identity_bank"] = np.empty((0, 0), dtype=np.float32)
            arrays["reference_identity_threshold"] = np.array([V14_REFERENCE_ID_MAX_THRESHOLD], dtype=np.float32)
        if product.defect_classifier is not None:
            for key, value in product.defect_classifier.export().items():
                arrays[f"defect_{key}"] = value
        else:
            arrays["defect_present"] = np.array([0], dtype=np.int32)
        np.savez_compressed(path, **arrays)
        registry["products"].append({
            "name": product.name,
            "directory_name": product.directory_name,
            "file": str(path.relative_to(folder)).replace("\\", "/"),
            "sample_count": product.sample_count,
            "reference_bbox": list(ref_box) if ref_box is not None else None,
            "reference_identity_threshold": float(getattr(product, "reference_identity_threshold", V14_REFERENCE_ID_MAX_THRESHOLD)),
            "defect_classes": product.defect_classifier.classes if product.defect_classifier is not None else [],
            "defect_sample_counts": product.defect_classifier.sample_counts if product.defect_classifier is not None else {},
        })
    for old in product_folder.glob("*.npz"):
        if old.resolve() not in live_files:
            try:
                old.unlink()
            except OSError:
                pass
    if self.identity_classifier is not None:
        np.savez_compressed(
            folder / "identity_classifier.npz",
            coef=np.asarray(self.identity_classifier.coef_, dtype=np.float32),
            intercept=np.asarray(self.identity_classifier.intercept_, dtype=np.float32),
            classes=np.asarray([str(x) for x in self.identity_classifier.classes_], dtype=str),
            n_features=np.array([self.identity_classifier.n_features_in_], dtype=np.int32),
            n_iter=np.asarray(getattr(self.identity_classifier, "n_iter_", [0]), dtype=np.int32),
        )
    else:
        try:
            (folder / "identity_classifier.npz").unlink()
        except OSError:
            pass
    registry_path = folder / "registry.json"
    registry_path.write_text(json.dumps(registry, indent=2, ensure_ascii=False), encoding="utf-8")
    self.created_at = str(registry["created_at"])
    return registry_path


LabeledProductModel.save = _v14_save


def _v14_load(self: LabeledProductModel, folder: Path) -> Path:
    registry_path = folder / "registry.json"
    if not registry_path.exists():
        raise FileNotFoundError(f"No saved model registry found at:\n{registry_path}")
    registry = json.loads(registry_path.read_text(encoding="utf-8"))
    version = int(registry.get("format_version", -1))
    if version != MODEL_FORMAT_VERSION:
        raise RuntimeError(
            f"Saved model format {version} is not supported by V14. Rebuild the models from the current labeled datasets."
        )
    loaded: list[ProductModel] = []
    specs = registry.get("products", [])
    if not specs:
        raise RuntimeError("Saved model registry contains no products.")
    for spec in specs:
        path = folder / str(spec["file"])
        if not path.exists():
            raise FileNotFoundError(f"Missing product model file:\n{path}")
        with np.load(path, allow_pickle=False) as data:
            detector = PatchCoreDetector(self.extractor)
            detector.import_saved({
                "memory_bank": data["memory_bank"],
                "threshold": data["threshold"],
                "calibration_low": data["calibration_low"],
                "calibration_high": data["calibration_high"],
                "metadata": data["metadata"],
            })
            product_name = str(data["product_name"])
            directory_name = str(data["directory_name"])
            identity_bank = np.asarray(data["identity_bank"], dtype=np.float32)
            identity_centroid = np.asarray(data["identity_centroid"], dtype=np.float32)
            nn_thr = float(np.asarray(data["identity_nn_threshold"]).reshape(-1)[0])
            centroid_thr = float(np.asarray(data["identity_centroid_threshold"]).reshape(-1)[0])
            sample_count = int(np.asarray(data["sample_count"]).reshape(-1)[0])
            ref_box = None
            ref_bank = None
            ref_thr = V14_REFERENCE_ID_MAX_THRESHOLD
            if "reference_bbox" in data.files:
                raw_box = np.asarray(data["reference_bbox"], dtype=np.int32).reshape(-1)
                if raw_box.size == 4:
                    ref_box = tuple(int(v) for v in raw_box)
            if "reference_identity_bank" in data.files:
                raw_bank = np.asarray(data["reference_identity_bank"], dtype=np.float32)
                if raw_bank.ndim == 2 and raw_bank.shape[0] > 0:
                    ref_bank = raw_bank
            if "reference_identity_threshold" in data.files:
                ref_thr = float(np.asarray(data["reference_identity_threshold"]).reshape(-1)[0])
            defect_classifier = None
            if "defect_present" in data.files:
                defect_classifier = ProductDefectClassifier(self.extractor)
                defect_data = {key[len("defect_"):]: data[key] for key in data.files if key.startswith("defect_")}
                defect_classifier.import_saved(defect_data)
                if defect_classifier.classifier is None:
                    defect_classifier = None
        product = ProductModel(
            name=product_name,
            directory_name=directory_name,
            identity_bank=identity_bank,
            identity_centroid=identity_centroid,
            identity_nn_threshold=nn_thr,
            identity_centroid_threshold=centroid_thr,
            detector=detector,
            sample_count=sample_count,
            defect_classifier=defect_classifier,
        )
        _v14_attach_product_reference(product, ref_box, ref_bank, ref_thr)
        loaded.append(product)
    self.products = sorted(loaded, key=lambda p: p.directory_name.lower())
    self.created_at = str(registry.get("created_at", ""))
    self._load_classifier(folder)
    if self.identity_classifier is None and len(self.products) >= 2:
        self.rebuild_identity_classifier()
    return registry_path


LabeledProductModel.load = _v14_load


def _v14_summary(self: LabeledProductModel) -> str:
    if not self.products:
        return "MODEL: no labeled products loaded"
    lines = [
        f"LABELED MODEL SET: {len(self.products)} product(s)",
        f"Created: {self.created_at}",
        f"Identity classifier: {'ON' if self.identity_classifier is not None else 'single-product/gates-only'}",
        "Geometry: V14 multi-component localization + fixed reference window anomaly inspection",
    ]
    for product in self.products:
        defect_text = ", ".join(product.defect_classifier.classes) if product.defect_classifier is not None else "none (anomaly-only)"
        ref_text = str(getattr(product, "reference_bbox", None)) if getattr(product, "reference_bbox", None) is not None else "legacy/tight-crop"
        lines.append(
            f"• {product.name}: {product.sample_count} GOOD | defects: {defect_text} | "
            f"ID NN≤{product.identity_nn_threshold:.4f} | centroid≤{product.identity_centroid_threshold:.4f} | "
            f"anomaly≤{product.detector.threshold:.5f} | REF={ref_text}"
        )
    if self.identity_classifier is not None:
        lines.append(
            f"Product classifier gates: probability≥{self.classifier_prob_threshold:.3f}, margin≥{self.classifier_margin_threshold:.3f}"
        )
    return "\n".join(lines)


LabeledProductModel.summary = _v14_summary

